<UserControl x:Class="AUTZ.IronWorks.Preview.Views.ColourField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,4,0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Swatch" CornerRadius="3" Width="34" Height="34" 
                    BorderBrush="#6F6F7D" BorderThickness="1" Cursor="Hand"
                    ToolTip="Click to pick a colour" MouseLeftButtonUp="Swatch_Click"/>

            <TextBox x:Name="HexBox" Grid.Column="1" Margin="8,0,8,0" VerticalContentAlignment="Center"
                     TextChanged="HexBox_TextChanged"/>

            <Button Grid.Column="2" Content="Pick…" Padding="14,0" Click="Pick_Click"/>

            <Button x:Name="ClearBtn" Grid.Column="3" Content="✕" Width="30" Margin="6,0,0,0"
                    Visibility="Collapsed" ToolTip="Clear (use the default colour)" Click="Clear_Click"/>
        </Grid>

        <WrapPanel x:Name="Presets" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>

