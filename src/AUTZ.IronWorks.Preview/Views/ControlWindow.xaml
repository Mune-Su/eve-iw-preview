<Window x:Class="AUTZ.IronWorks.Preview.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUTZ IronWorks Preview"
        Width="360" Height="360"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#10151C" Foreground="#E5E7EB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="AUTZ IRONWORKS PREVIEW" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
        <TextBlock x:Name="StatusText" Margin="0,12,0,4" Foreground="#E5E7EB"/>
        <TextBlock x:Name="ClientList" Margin="0,0,0,16" Foreground="#94A3B8" TextWrapping="Wrap"/>

        <Button x:Name="ToggleBtn" Content="Hide thumbnails" Click="Toggle_Click"/>
        <Button Content="Settings…" Click="Settings_Click"/>
        <Button Content="Reset all positions" Click="Reset_Click"/>
        <Button Content="Exit" Click="Exit_Click"/>

        <TextBlock Margin="0,8,0,0" Foreground="#64748B" TextWrapping="Wrap" FontSize="11"
                   Text="Left-click a thumbnail to switch. Hold right-click and drag to move it. Drag the bottom-right corner to resize."/>
    </StackPanel>
</Window>
