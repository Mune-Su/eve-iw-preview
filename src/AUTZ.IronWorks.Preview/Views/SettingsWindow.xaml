ckFrequency="5"/><TextBlock x:Name="NotifyVolumeText" Text="80%" Width="38" Margin="6,0,0,0" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="2" Content="Test" Padding="10,4" Margin="6,0,0,0" Click="TestMainSound_Click" ToolTip="Play this sound"/><Button Grid.Column="3" Content="Add sounds…" Padding="10,4" Margin="6,0,0,0" Click="AddSound_Click" ToolTip="Pick one or more files. .wav, .mp3, .m4a, .wma or .aac. Max 5 MB each."/></Grid><TextBox Style="{StaticResource Desc}" Text="Add your own sounds: .wav, .mp3, .m4a, .wma or .aac. Max 5 MB each, plays up to 10 seconds."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Same Alert Sound Gap (s)"/><TextBox x:Name="SoundGapBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource Desc}" Text="0–30. 0 = every alert plays." Margin="0,24,0,0"/></StackPanel></Grid><CheckBox x:Name="NotifySpeakBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Speak the alert out loud"/></CheckBox><WrapPanel Margin="0,0,0,2"><Button x:Name="TestNotifyBtn" Content="Send a test alert" Padding="10,4" Margin="0,0,6,6" Click="TestNotify_Click"/></WrapPanel></StackPanel>
