<Window x:Class="AUTZ.IronWorks.Preview.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUTZ IronWorks Preview Settings"
        Width="470" Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#10151C" Foreground="#E5E7EB"
        ResizeMode="NoResize" Topmost="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#18202A"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PREVIEW SETTINGS" FontSize="22" FontWeight="Bold" Foreground="#F59E0B"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,12">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="GENERAL" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,8"/>

                <TextBlock Text="Default preview width (120-1200)"/>
                <TextBox x:Name="WidthBox"/>

                <TextBlock Text="Client scan interval in milliseconds (500-10000)"/>
                <TextBox x:Name="RefreshBox"/>

                <CheckBox x:Name="LabelsBox" Content="Show character names on thumbnails" Foreground="#E5E7EB" Margin="0,0,0,10"/>

                <TextBlock Text="Default label colour (hex)"/>
                <TextBox x:Name="LabelColourBox"/>

                <CheckBox x:Name="HighlightBox" Content="Highlight the active client with a border" Foreground="#E5E7EB" Margin="0,0,0,10"/>

                <TextBlock Text="Highlight colour (hex)"/>
                <TextBox x:Name="ColourBox"/>

                <CheckBox x:Name="LockBox" Content="Lock thumbnail positions (no dragging)" Foreground="#E5E7EB" Margin="0,0,0,10"/>

                <CheckBox x:Name="SnapBox" Content="Snap thumbnails together when dragged close" Foreground="#E5E7EB" Margin="0,0,0,10"/>

                <TextBlock Text="Snap distance in pixels (1-100)"/>
                <TextBox x:Name="SnapDistBox" Margin="0,4,0,18"/>

                <TextBlock Text="HOTKEYS" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,4"/>
                <TextBlock Text="Click a box, then press the keys you want. Backspace clears it." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="Next client"/>
                <TextBox x:Name="ForwardBox" PreviewKeyDown="HotkeyBox_PreviewKeyDown" InputMethod.IsInputMethodEnabled="False"/>
                <TextBlock Text="Previous client"/>
                <TextBox x:Name="BackBox" PreviewKeyDown="HotkeyBox_PreviewKeyDown" InputMethod.IsInputMethodEnabled="False"/>

                <TextBlock Text="PER-CHARACTER" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,8"/>
                <TextBlock x:Name="NoCharText" Text="No characters known yet. Log in an EVE client, then reopen settings." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
                <ComboBox x:Name="CharBox" Foreground="#111827" Margin="0,0,0,12" SelectionChanged="CharBox_SelectionChanged"/>

                <TextBlock Text="Label text (empty = character name)"/>
                <TextBox x:Name="LabelBox"/>
                <TextBlock Text="Label colour (hex, empty = default)"/>
                <TextBox x:Name="CharColourBox"/>
                <TextBlock Text="Width (0 = default)"/>
                <TextBox x:Name="CharWidthBox"/>
                <TextBlock Text="Height (0 = automatic 16:9)"/>
                <TextBox x:Name="CharHeightBox"/>
                <TextBlock Text="Jump-to-this-client hotkey"/>
                <TextBox x:Name="CharHotkeyBox" PreviewKeyDown="HotkeyBox_PreviewKeyDown" InputMethod.IsInputMethodEnabled="False"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Background="#F59E0B" Foreground="#111827" FontWeight="Bold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
