<StackPanel><TextBox Style="{StaticResource Desc}" Text="Top 10 programs by memory. Arrow = change in the last minute."/><StackPanel x:Name="TopProgsHost"/><TextBox x:Name="TopProgsNote" Style="{StaticResource Desc}" Margin="0,6,0,12" Text="Reading programs..."/></StackPanel>
</Expander>
<Expander x:Name="CardMemoryKeep" Header="EXCLUSIONS" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="The program in front and Windows itself are never trimmed."/><TextBox Style="{StaticResource FieldLabel}" Text="Smallest Program To Trim (MB)" /><TextBox x:Name="MemMinMbBox" /><TextBox Style="{StaticResource Desc}" Text="Smaller programs are skipped. 0–4096 (0 = trim all)."/><TextBox Style="{StaticResource FieldLabel}" Text="EVE Clients" /><RadioButton x:Name="MemEveNeverRadio" GroupName="MemEve"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Never trim EVE clients (recommended)"/></RadioButton><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><RadioButton x:Name="MemEveIdleRadio" GroupName="MemEve" Margin="0" VerticalAlignment="Center"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Trim EVE clients in the background after they have been idle for"/></RadioButton><TextBox x:Name="MemEveIdleBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><RadioButton x:Name="MemEveAllRadio" GroupName="MemEve"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Trim EVE clients like any other program"/></RadioButton><TextBox Style="{StaticResource Desc}" Text="Trimmed clients can stutter when you switch back. Idle: 1–1440 min."/><TextBox Style="{StaticResource FieldLabel}" Text="Never Trim These Programs" /><TextBox x:Name="MemExcludeBox" /><TextBox Style="{StaticResource Desc}" Text="Names without .exe, separated by commas, e.g. discord, obs64."/></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch"><Expander x:Name="CardAbout" Header="ABOUT" Style="{StaticResource Card}" IsExpanded="False"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Image Source="/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="EVE-IronWorks-Preview" FontWeight="Bold" FontSize="17" Foreground="White"/><TextBox x:Name="VersionText" Style="{StaticResource SelectableText}" Text="v0.0.0" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/><TextBlock FontSize="12" Margin="0,3,0,0"><Hyperlink Style="{StaticResource CreditLink}" NavigateUri="https://autz-ironworks.vercel.app/#/home" RequestNavigate="Website_RequestNavigate">by AUTZ IronWorks · From planets to profit</Hyperlink></TextBlock></StackPanel></StackPanel><TextBox Style="{StaticResource Desc}" Text="Live previews of all your EVE clients, with instant switching."/><TextBox Style="{StaticResource Desc}" Text="Windows only (10 and 11, 64-bit). Not for macOS or Linux."/><TextBox Style="{StaticResource Desc}" Text="• Click a thumbnail or press a hotkey to jump to a client."/><TextBox Style="{StaticResource Desc}" Text="• Alerts for combat, warp scrams, mining, fleet warps and more, read from EVE's own logs."/><TextBox Style="{StaticResource Desc}" Text="• Profiles, groups, saved layouts and client hotkeys."/><TextBox Style="{StaticResource Desc}" Text="• Memory cleaner and performance options."/><TextBox Style="{StaticResource Desc}" Text="It only shows pictures of your clients and brings windows to the front. It never sends keys or clicks to EVE."/><TextBox Style="{StaticResource Desc}" Text="Free software under the GPL-3.0. No warranty."/><TextBox Style="{StaticResource Desc}" Text="Instant switching adapted from EVE-Maj Preview by mrmjstc."/><WrapPanel Margin="0,0,0,6"><Button Content="View license" Padding="10,4" Margin="0,0,6,0" Click="License_Click"/><Button Content="Discord" Padding="10,4" Margin="0,0,6,0" Click="Discord_Click"/><Button Content="GitHub" Padding="10,4" Margin="0,0,6,0" Click="GitHub_Click"/><Button x:Name="UpdateNowBtn" Content="Update" Padding="10,4" Margin="0,0,6,0" IsEnabled="False" ToolTip="Checking for updates" Click="UpdateNow_Click"/></WrapPanel></StackPanel></Expander></StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageDiagnostics" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch"><Expander x:Name="CardFiles" Header="FILES" Style="{StaticResource Card}" IsExpanded="False"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Where your profiles and logs are kept."/><TextBox x:Name="FolderText" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource BrushText}"/><WrapPanel Margin="0,0,0,2"><Button x:Name="OpenFolderBtn" Content="Open folder" Padding="10,4" Margin="0,0,6,6" Click="OpenFolder_Click" /><Button x:Name="OpenLogBtn" Content="Open log" Padding="10,4" Margin="0,0,6,6" Click="OpenLog_Click" /></WrapPanel></StackPanel></Expander><Expander x:Name="CardDiagnostics" Header="LOGS" Style="{StaticResource Card}" IsExpanded="False"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Detailed logging records everything the app does. Turn it on, repeat the problem, then open the log."/><CheckBox x:Name="DebugLogBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Detailed logging"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Log File" /><RadioButton x:Name="DebugContinuousRadio" GroupName="DebugMode"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="One log file (debug.log)"/></RadioButton><RadioButton x:Name="DebugSessionRadio" GroupName="DebugMode"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="A new log file each time it's turned on"/></RadioButton><WrapPanel Margin="0,0,0,2"><Button x:Name="OpenDebugLogBtn" Content="Open debug log" Padding="10,4" Margin="0,0,6,6" Click="OpenDebugLog_Click" /><Button x:Name="ClearDebugLogBtn" Content="Clear debug log" Padding="10,4" Margin="0,0,6,6" Click="ClearDebugLog_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Names show as codes (e.g. Pilot-3FA9C1), so a log is safe to share."/></StackPanel></Expander></StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageAdmin" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch"><Expander x:Name="CardOwnerTrace" Header="WINDOWS MEMORY TRACE" Style="{StaticResource Card}" IsExpanded="False"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Private 60-second Windows ETW capture. May include system paths. Requires administrator rights."/><WrapPanel><Button x:Name="OwnerTraceStartBtn" Content="Start 60-second trace" Margin="0,0,6,6" Click="OwnerTraceStart_Click"/><Button x:Name="OwnerTraceStopBtn" Content="Stop trace" Margin="0,0,6,6" Click="OwnerTraceStop_Click"/><Button Content="Open trace folder" Margin="0,0,6,6" Click="OwnerTraceFolder_Click"/></WrapPanel><TextBox x:Name="OwnerTraceStatus" Style="{StaticResource Desc}" Text="Tracing is off."/></StackPanel></Expander></StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageMap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch"><Expander x:Name="CardMapSetup" Header="MAP" Style="{StaticResource Card}" IsExpanded="False"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Full New Eden map and regional zoom are planned. No map service is running."/><Button Content="Open New Eden Map" Click="OpenMap_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel></Expander></StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageIntel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch"><Expander x:Name="CardIntelSetup" Header="INTEL" Style="{StaticResource Card}" IsExpanded="False"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Intel from selected EVE chat logs is planned. No intel scanner is running."/><Button Content="Open Intel Scanner" Click="OpenIntel_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel></Expander></StackPanel></ScrollViewer>
<ScrollViewer x:Name="PagePings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch"><Expander x:Name="CardPingsSetup" Header="PINGS" Style="{StaticResource Card}" IsExpanded="False"><StackPanel><TextBox Style="{StaticResource FieldLabel}" Text="Protocol"/><ComboBox x:Name="JabberProtocol"><ComboBoxItem Content="XMPP"/></ComboBox>
<TextBox Style="{StaticResource FieldLabel}" Text="Username"/><TextBox x:Name="JabberUsername"/>
<TextBox Style="{StaticResource FieldLabel}" Text="Domain"/><TextBox x:Name="JabberDomain"/>
<TextBox Style="{StaticResource FieldLabel}" Text="Resource (optional)"/><TextBox x:Name="JabberResource"/>
<TextBox Style="{StaticResource FieldLabel}" Text="Password"/><PasswordBox x:Name="JabberPassword" Margin="0,0,0,8" Background="{StaticResource BrushInput}" Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushLine}" Padding="7,3"/>
<CheckBox x:Name="JabberRemember"><TextBlock Text="Remember password"/></CheckBox>
<CheckBox x:Name="JabberAuto"><TextBlock Text="Connect automatically"/></CheckBox>
<CheckBox x:Name="JabberNotify"><TextBlock Text="Notify me about pings"/></CheckBox>
<TextBlock x:Name="JabberStatus" Text="Disconnected" Margin="0,6,0,8"/>
<WrapPanel><Button Content="Save Jabber" Click="JabberSave_Click" Margin="0,0,8,0"/><Button Content="Connect" Click="JabberConnect_Click" Margin="0,0,8,0"/><Button Content="Disconnect" Click="JabberDisconnect_Click" Margin="0,0,8,0"/><Button Content="Open Pings" Click="JabberOpen_Click"/></WrapPanel></StackPanel></Expander></StackPanel></ScrollViewer>
            </Grid>

            <!-- footer: search, status, buttons -->
            <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Padding="22,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="230">
                        <TextBox x:Name="SearchBox" Margin="0" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Search settings ..." Foreground="{StaticResource BrushDim}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                    <TextBox x:Name="StatusText" Style="{StaticResource SelectableText}" Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ResetBtn" Content="Reset" Width="82" Margin="0,0,16,0" Click="Reset_Click" ToolTip="Put this profile's settings back to their defaults"/>
                        <Button x:Name="ApplyBtn" Content="Apply" Width="82" Margin="0,0,8,0" Click="Apply_Click" ToolTip="Use these settings now, without saving them"/>
                        <Button x:Name="SaveBtn" Content="Save" Width="82" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Save these settings to the config file"/>
                        <Button x:Name="CloseBtn" Content="Close" Width="82" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>







