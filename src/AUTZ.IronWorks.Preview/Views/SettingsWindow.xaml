<Window x:Class="AUTZ.IronWorks.Preview.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AUTZ IronWorks Preview Settings" Width="430" Height="390" WindowStartupLocation="CenterOwner" Background="#10151C" Foreground="#E5E7EB" ResizeMode="NoResize">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="PREVIEW SETTINGS" FontSize="22" FontWeight="Bold" Foreground="#F59E0B"/>
<StackPanel Grid.Row="1" Margin="0,24,0,20">
<TextBlock Text="Preview width (180-640)"/><TextBox x:Name="WidthBox" Margin="0,5,0,14" Padding="7"/>
<TextBlock Text="Client scan interval in milliseconds (500-10000)"/><TextBox x:Name="RefreshBox" Margin="0,5,0,14" Padding="7"/>
<CheckBox x:Name="VerticalBox" Content="Vertical layout" Margin="0,0,0,12"/>
<CheckBox x:Name="LabelsBox" Content="Show character labels" Margin="0,0,0,12"/>
<TextBlock Text="Active border colour (hex)"/><TextBox x:Name="ColourBox" Margin="0,5,0,0" Padding="7"/>
</StackPanel>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="Save" Width="90" Background="#F59E0B" Foreground="#111827" FontWeight="Bold" Click="Save_Click"/></StackPanel>
</Grid></Window>