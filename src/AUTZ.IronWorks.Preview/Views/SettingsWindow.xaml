<Expander x:Name="CardLogSystem" Header="SYSTEM NAME" Style="{StaticResource Card}">
   <StackPanel><TextBox Style="{StaticResource Desc}" Text="Reads the Local chat log to learn which solar system each character is in."/><CheckBox x:Name="LogSystemBox"><TextBlock TextWrapping="Wrap" Text="Show the solar system next to the name on each thumbnail"/></CheckBox></StackPanel>
</Expander></StackPanel></ScrollViewer><ScrollViewer x:Name="PageMemory" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><Expander x:Name="CardMemoryNow" Header="MEMORY" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Your PC's memory right now. Trim Programs asks Windows to take back memory that programs aren't actively using, so it can be used for something else. Windows manages memory well on its own, so this mostly helps when RAM is nearly full. Restart Windows Explorer closes and restarts the taskbar, the desktop and any File Explorer windows, which also gives back the memory Explorer has built up."/><TextBox x:Name="MemUsageText" Style="{StaticResource SelectableText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Text="Reading memory..."/><Border x:Name="MemTrack" Height="18" Margin="0,0,0,8" CornerRadius="3" Background="{StaticResource BrushInput}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"><Border x:Name="MemFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource BrushAccent}"/></Border><TextBox x:Name="MemCommitText" Style="{StaticResource SelectableText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,4" Text=""/><TextBox x:Name="MemStatsText" Style="{StaticResource SelectableText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12" Text=""/><WrapPanel Margin="0,0,0,6"><Button x:Name="MemTrimBtn" Content="Trim Programs" Padding="12,6" Margin="0,0,8,8" Click="MemTrim_Click" /><Button x:Name="MemCacheBtn" Content="Clear system cache" Padding="12,6" Margin="0,0,8,8" Click="MemCache_Click" /><Button x:Name="MemClipboardBtn" Content="Clear clipboard" Padding="12,6" Margin="0,0,8,8" Click="MemClipboard_Click" /><Button x:Name="MemExplorerBtn" Content="Restart Windows Explorer" Padding="12,6" Margin="0,0,8,8" Click="RestartExplorer_Click" /></WrapPanel><TextBox x:Name="MemResultText" Style="{StaticResource SelectableText}" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,4" Text=""/><TextBox x:Name="MemSessionText" Style="{StaticResource SelectableText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12" Text=""/><TextBox x:Name="MemAdminNote" Style="{StaticResource Desc}" Visibility="Collapsed" Text="Clearing the system cache needs administrator rights, so it is switched off while the app runs normally. Trimming works for your own programs either way; as administrator it also reaches programs that other accounts started."/><WrapPanel x:Name="MemAdminPanel" Margin="0,0,0,6" Visibility="Collapsed"><Button x:Name="RestartAdminBtn" Content="Restart as administrator" Padding="12,6" Margin="0,0,8,8" Click="RestartAdmin_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="The average, lowest and highest figures come from the readings taken while this page is open and by the automatic checks, not from the whole day."/></StackPanel></Expander><Expander x:Name="CardMemoryTop" Header="TOP PROGRAMS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The 10 programs using the most memory, refreshed every 10 seconds while this page is open (nothing is read while it is closed or the window is minimised). A program with several processes is added together. The arrow compares with about a minute ago; a yellow 'growing' tag marks a program whose memory has kept rising for several minutes, which can mean a leak. These trends build up only while this page is open. Trim asks Windows to take back that program's idle memory now. Never trim puts it on the never-trim list below (press Apply or Save to keep that)."/><StackPanel x:Name="TopProgsHost"/><TextBox x:Name="TopProgsNote" Style="{StaticResource Desc}" Margin="0,6,0,12" Text="Reading programs..."/></StackPanel></Expander><Expander x:Name="CardMemoryAuto" Header="AUTOMATIC CLEANING" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Everything here is off until you switch it on, and nothing runs in the background while it is off. These settings are for the whole app, not for a profile."/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemTrimEveryBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Trim programs every"/></CheckBox><TextBox x:Name="MemTrimMinutesBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemCacheEveryBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Clear system cache every"/></CheckBox><TextBox x:Name="MemCacheMinutesBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="28,0,0,8"><CheckBox x:Name="MemCacheOnlyLowBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="...but only while free memory is below"/></CheckBox><TextBox x:Name="MemCacheLowPercentBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="%" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemTrimAboveBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Trim programs when memory use exceeds"/></CheckBox><TextBox x:Name="MemTrimPercentBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="%" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><CheckBox x:Name="MemCacheAboveBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Clear system cache when memory use exceeds"/></CheckBox><TextBox x:Name="MemCachePercentBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="%" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><CheckBox x:Name="MemLimitsBox"><TextBlock TextWrapping="Wrap" Text="Trim a program when it goes over its own limit"/></CheckBox><TextBox x:Name="MemLimitsText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><TextBox Style="{StaticResource Desc}" Text="One program per line as name=megabytes, for example: chrome=1500 (names as shown on the Details tab of Task Manager, without .exe; 50 to 65536 MB). All the processes of that name are added together, and each program is trimmed at most once every 3 minutes. The never-trim list and the program in front still win."/><TextBox Style="{StaticResource Desc}" Text="Minutes: 1 to 1440. Limits: 50 to 99 percent. While a limit is switched on, memory use is checked every 30 seconds, and it cleans at most once every 3 minutes, so a PC that really needs all its RAM isn't cleaned over and over. The 'only while free memory is below' box (5 to 90 percent) stops the scheduled cache clearing from running when there is plenty of free memory; the usage limit above it is separate."/><CheckBox x:Name="MemNotifyBox"><TextBlock TextWrapping="Wrap" Text="Show a Windows notification when it cleans by itself"/></CheckBox></StackPanel></Expander><Expander x:Name="CardMemoryKeep" Header="WHAT IT LEAVES ALONE" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The program you are using at that moment is never trimmed, and neither are Windows' own core processes or the Windows audio engine."/><TextBox Style="{StaticResource FieldLabel}" Text="Smallest Program To Trim (MB)" /><TextBox x:Name="MemMinMbBox" /><TextBox Style="{StaticResource Desc}" Text="Programs using less memory than this are skipped, because trimming them gains almost nothing. 0 trims everything (0 to 4096). This applies to Trim Programs and automatic cleaning, not to the Trim button next to a program."/><TextBox Style="{StaticResource FieldLabel}" Text="EVE Clients" /><RadioButton x:Name="MemEveNeverRadio" GroupName="MemEve"><TextBlock TextWrapping="Wrap" Text="Never trim EVE clients (recommended)"/></RadioButton><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><RadioButton x:Name="MemEveIdleRadio" GroupName="MemEve" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Trim EVE clients in the background after they have been idle for"/></RadioButton><TextBox x:Name="MemEveIdleBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><RadioButton x:Name="MemEveAllRadio" GroupName="MemEve"><TextBlock TextWrapping="Wrap" Text="Trim EVE clients like any other program"/></RadioButton><TextBox Style="{StaticResource Desc}" Text="Trimming a background client frees its memory, but when you switch back to it Windows has to bring that memory back in, which can cause a short stutter. The idle option avoids that for the clients you switch between: the one you are in is never trimmed, and a background client is only trimmed once it has been out of front for the time you set (1 to 1440 minutes)."/><TextBox Style="{StaticResource FieldLabel}" Text="Never Trim These Programs" /><TextBox x:Name="MemExcludeBox" /><TextBox Style="{StaticResource Desc}" Text="Program names as shown on the Details tab of Task Manager, without .exe, separated by commas. For example: discord, obs64. The Never trim button in Top Programs adds to this list."/></StackPanel></Expander></StackPanel></ScrollViewer><ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><Expander x:Name="CardAbout" Header="ABOUT" Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Image Source="/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="EVE-IronWorks-Preview" FontWeight="Bold" FontSize="17" Foreground="White"/><TextBox x:Name="VersionText" Style="{StaticResource SelectableText}" Text="v0.0.0" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/><TextBlock FontSize="12" Margin="0,3,0,0"><Hyperlink Style="{StaticResource CreditLink}" NavigateUri="https://autz-ironworks.vercel.app/#/home" RequestNavigate="Website_RequestNavigate">by AUTZ IronWorks · From planets to profit</Hyperlink></TextBlock></StackPanel></StackPanel><TextBox Style="{StaticResource Desc}" Text="Also known as EVE-IW-Preview (the exe, the GitHub repository and posts). Live previews of your running EVE Online clients and instant client switching. It only shows a picture of each client and brings the window to the front: it never sends keys or mouse clicks to EVE."/></StackPanel></Expander><Expander x:Name="CardWhatsNew" Header="WHAT'S NEW" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The pop-up with the version and the latest changes."/><TextBox Style="{StaticResource FieldLabel}" Text="Show The Pop-Up" /><ComboBox x:Name="WhatsNewCombo" /><WrapPanel Margin="0,0,0,6"><Button x:Name="ViewChangelogBtn" Content="View changelog" Padding="12,6" Margin="0,0,8,8" Click="ViewChangelog_Click" /></WrapPanel></StackPanel></Expander><Expander x:Name="CardFiles" Header="FILES" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Profiles, the active-profile file and the diagnostics log live here."/><TextBox x:Name="FolderText" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource BrushText}"/><WrapPanel Margin="0,0,0,6"><Button x:Name="OpenFolderBtn" Content="Open folder" Padding="12,6" Margin="0,0,8,8" Click="OpenFolder_Click" /><Button x:Name="OpenLogBtn" Content="Open log" Padding="12,6" Margin="0,0,8,8" Click="OpenLog_Click" /></WrapPanel></StackPanel></Expander><Expander x:Name="CardDiagnostics" Header="DIAGNOSTICS (ADMIN LOG)" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Detailed logging writes every step the app takes to debug.log, with millisecond timestamps: each hotkey press, each focus attempt and which method worked, every minimise, restore and maximise it sends to a client, thumbnails shown, hidden, created and closed, and every focus change Windows reports. Turn it on, reproduce the problem, then open the log. It is written in the background, so it doesn't slow switching down. This setting is app-wide, not per profile."/><CheckBox x:Name="DebugLogBox"><TextBlock TextWrapping="Wrap" Text="Detailed logging"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Log File" /><RadioButton x:Name="DebugContinuousRadio" GroupName="DebugMode"><TextBlock TextWrapping="Wrap" Text="One continuous log (debug.log) that carries on each time logging is turned on"/></RadioButton><RadioButton x:Name="DebugSessionRadio" GroupName="DebugMode"><TextBlock TextWrapping="Wrap" Text="A new log every time logging is turned on (debug-DATE_TIME.log), so each test is its own file"/></RadioButton><WrapPanel Margin="0,0,0,6"><Button x:Name="OpenDebugLogBtn" Content="Open debug log" Padding="12,6" Margin="0,0,8,8" Click="OpenDebugLog_Click" /><Button x:Name="ClearDebugLogBtn" Content="Clear debug log" Padding="12,6" Margin="0,0,8,8" Click="ClearDebugLog_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Privacy: the logs never contain character names, profile names, the titles of other windows, your Windows user name, your PC name or folder paths. A character or profile name shows as a short code (for example Pilot-3FA9C1): the same name always gives the same code on this PC, but the name can't be worked out from it, so a log can be sent to someone safely. Also in the tray menu: Detailed Logging and Open Debug Log. Open debug log opens the newest one. The continuous log rolls over to debug.old.log at about 4 MB; the newest 20 separate logs are kept. Changing the setting while logging is on carries on in the other kind of file straight away."/></StackPanel></Expander></StackPanel></ScrollViewer>
            </Grid>

            <!-- footer: search, status, buttons -->
            <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Padding="22,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="230">
                        <TextBox x:Name="SearchBox" Margin="0" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Search settings ..." Foreground="{StaticResource BrushDim}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                    <TextBox x:Name="StatusText" Style="{StaticResource SelectableText}" Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ResetBtn" Content="Reset" Width="82" Margin="0,0,16,0" Click="Reset_Click" ToolTip="Put this profile's settings back to their defaults"/>
                        <Button x:Name="ApplyBtn" Content="Apply" Width="82" Margin="0,0,8,0" Click="Apply_Click" ToolTip="Use these settings now, without saving them"/>
                        <Button x:Name="SaveBtn" Content="Save" Width="82" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Save these settings to the config file"/>
                        <Button x:Name="CloseBtn" Content="Close" Width="82" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
