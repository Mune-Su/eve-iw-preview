<Expander x:Name="CardMemoryNow" Header="MEMORY" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Memory in use now. Grey lines are estimates."/><TextBox x:Name="MemUsageText" Style="{StaticResource SelectableText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Text="Reading memory..."/><Border x:Name="MemTrack" Height="18" Margin="0,0,0,8" CornerRadius="3" Background="{StaticResource BrushInput}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"><Border x:Name="MemFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource BrushAccent}"/></Border><TextBox x:Name="MemCommitText" Style="{StaticResource SelectableText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,4" Text=""/><TextBox x:Name="MemStatsText" Style="{StaticResource SelectableText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12" Text=""/><WrapPanel Margin="0,0,0,2"><StackPanel Margin="0,0,8,2" Width="200"><Button x:Name="MemTrimBtn" Content="Trim Programs" Padding="10,4" Margin="0" HorizontalAlignment="Left" Click="MemTrim_Click"/><TextBox x:Name="MemTrimEstimate" Style="{StaticResource Desc}" FontSize="11.5" Margin="1,4,0,4" ToolTip="An estimate of what Trim Programs would free, from the programs it would trim right now. After you have trimmed once it uses what that trim really gave back." Text="Estimating..."/></StackPanel><StackPanel Margin="0,0,8,2" Width="200"><Button x:Name="MemCacheBtn" Content="Clear system cache" Padding="10,4" Margin="0" HorizontalAlignment="Left" Click="MemCache_Click"/><TextBox x:Name="MemCacheEstimate" Style="{StaticResource Desc}" FontSize="11.5" Margin="1,4,0,4" ToolTip="Cached files can be dropped, and unsaved (modified) data is written to disk. Windows already counts cached files as available memory, so the Memory in use figure barely changes." Text="Estimating..."/></StackPanel><StackPanel Margin="0,0,8,2" Width="200"><Button x:Name="MemClipboardBtn" Content="Clear clipboard" Padding="10,4" Margin="0" HorizontalAlignment="Left" Click="MemClipboard_Click"/><TextBox x:Name="MemClipEstimate" Style="{StaticResource Desc}" FontSize="11.5" Margin="1,4,0,4" ToolTip="The size of the text or picture on the clipboard right now." Text="Estimating..."/></StackPanel><StackPanel Margin="0,0,8,2"><Button x:Name="MemExplorerBtn" Content="Restart Windows Explorer" Padding="10,4" Margin="0" HorizontalAlignment="Left" Click="RestartExplorer_Click"/></StackPanel></WrapPanel><TextBox x:Name="MemResultText" Style="{StaticResource AutoHideText}" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,4" Text=""/><TextBox x:Name="MemSessionText" Style="{StaticResource AutoHideText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12" Text=""/><TextBox x:Name="MemAdminNote" Style="{StaticResource Desc}" Visibility="Collapsed" Text="Clearing the cache needs administrator rights."/><WrapPanel x:Name="MemAdminPanel" Margin="0,0,0,6" Visibility="Collapsed"><Button x:Name="RestartAdminBtn" Content="Restart as administrator" Padding="10,4" Margin="0,0,6,6" Click="RestartAdmin_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Average, highest and lowest: since the app started."/><Border BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Margin="0,6,0,10"/><TextBox Style="{StaticResource FieldLabel}" Text="Automatic Cleaning"/><TextBox Style="{StaticResource Desc}" Text="All off until you turn it on."/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemTrimEveryBox" Margin="0" VerticalAlignment="Center"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Trim programs every"/></CheckBox><TextBox x:Name="MemTrimMinutesBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemCacheEveryBox" Margin="0" VerticalAlignment="Center"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Clear system cache every"/></CheckBox><TextBox x:Name="MemCacheMinutesBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemTrimAboveBox" Margin="0" VerticalAlignment="Center"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Trim programs when memory use exceeds"/></CheckBox><TextBox x:Name="MemTrimPercentBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="%" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><CheckBox x:Name="MemCacheAboveBox" Margin="0" VerticalAlignment="Center"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Clear system cache when memory use exceeds"/></CheckBox><TextBox x:Name="MemCachePercentBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="%" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><CheckBox x:Name="MemLimitsBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Trim a program when it goes over its own limit"/></CheckBox><TextBox x:Name="MemLimitsText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><TextBox Style="{StaticResource Desc}" Text="One per line: name=MB, e.g. chrome=1500. 50–65536 MB."/><TextBox Style="{StaticResource Desc}" Text="Minutes: 1–1440. Limits: 50–99%. At most one auto clean every 3 min."/><CheckBox x:Name="MemNotifyBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Show a Windows notification when it cleans by itself"/></CheckBox><TextBox x:Name="MemAutoNote" Style="{StaticResource AutoHideText}" Foreground="{StaticResource BrushAccentHover}" Margin="0,4,0,4" Text=""/><TextBox x:Name="MemEveHint" Style="{StaticResource Desc}" Visibility="Collapsed" Text="EVE clients aren't trimmed, and they use the most memory. Choose the idle option under Exclusions to free more."/></StackPanel>
