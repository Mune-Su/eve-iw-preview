   <StackPanel><TextBox Style="{StaticResource Desc}" Text="What counts as an event."/><CheckBox x:Name="LogAttackBox"><TextBlock TextWrapping="Wrap" Text="Under attack: incoming damage in the combat log"/></CheckBox><CheckBox x:Name="LogMiningBox"><TextBlock TextWrapping="Wrap" Text="Mining has gone quiet"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Quiet For (s)" /><TextBox x:Name="LogMiningSecondsBox" /><TextBox Style="{StaticResource Desc}" Text="Raises an alert when no mining lines have been logged for this long (10 or more)."/><TextBox Style="{StaticResource FieldLabel}" Text="Keywords" /><TextBox x:Name="LogKeywordsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><TextBox Style="{StaticResource Desc}" Text="One phrase per line. A game-log line containing one of them raises an alert (for example: warp scramble)."/></StackPanel>
