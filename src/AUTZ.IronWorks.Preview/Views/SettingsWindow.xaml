<Window x:Class="AUTZ.IronWorks.Preview.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AUTZ.IronWorks.Preview.Views"
        Title="EVE-IronWorks-Preview Configuration"
        Icon="/Assets/app.ico"
        Width="1100" Height="820" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}"
        FontFamily="Inter, Segoe UI" FontSize="13"
        ShowInTaskbar="True">
    <!-- Same layout as the website: a sidebar with the brand and the menu on the left, the page on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== sidebar ===== -->
        <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,20,14,18">
                    <Image Source="/Assets/logo.png" Width="40" Height="40" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,8"/>
                    <TextBlock Text="EVE-IronWorks" FontSize="19" FontWeight="Black" Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="PREVIEW" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource BrushAccent}" Margin="0,1,0,0"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"><Hyperlink Style="{StaticResource CreditLink}" NavigateUri="https://autz-ironworks.vercel.app/#/home" RequestNavigate="Website_RequestNavigate">by AUTZ IronWorks · From planets to profit</Hyperlink></TextBlock>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" Margin="12,0,12,10"/>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Margin="14,0,14,0" Padding="4,12,4,14">
                    <TextBox x:Name="SidebarVersion" Style="{StaticResource SelectableText}" Text="v0.0.0" FontSize="11" Foreground="{StaticResource BrushDim}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== right side: heading + profile bar, page, footer ===== -->
        <Grid Grid.Column="1" Background="{StaticResource BrushBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- viewhead: small caps label + page title, and the profile controls (like the website's toollinks) -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Padding="22,16,22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CONFIGURATION" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock x:Name="PageTitleText" Text="General" FontSize="26" FontWeight="Bold" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="PROFILE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileBox" Width="170" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="ProfileBox_SelectionChanged"/>
                            <Button Content="New" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="NewProfile_Click"/>
                            <Button Content="Copy" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="CopyProfile_Click"/>
                            <Button Content="Rename" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="RenameProfile_Click"/>
                            <Button Content="Delete" Margin="0,0,5,0" Padding="10,5" FontSize="12" Style="{StaticResource DangerButton}" Click="DeleteProfile_Click"/>
                            <Button Content="Import" Padding="10,5" FontSize="12" Click="ImportProfile_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileNote" Foreground="{StaticResource BrushAccentHover}" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Right"
                                   Visibility="Collapsed" Text="Save switches to this profile"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardStartup" Header="STARTUP AND TRAY ICON" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Saved with the app, not with a profile. Windows 11 tucks new tray icons behind the ^ (show hidden icons) arrow; the second option keeps the icon on the taskbar itself. It is Windows' own per-icon switch, so you can also change it under Settings &gt; Personalisation &gt; Taskbar &gt; Other system tray icons."/><CheckBox x:Name="RunOnStartupBox"><TextBlock TextWrapping="Wrap" Text="Run on Startup (launch EVE-IronWorks-Preview when you log into Windows)"/></CheckBox><CheckBox x:Name="PinTrayBox"><TextBlock TextWrapping="Wrap" Text="Keep the tray icon on the taskbar, not in the hidden icons"/></CheckBox><CheckBox x:Name="AlwaysAdminBox"><TextBlock TextWrapping="Wrap" Text="Always start as administrator (no Windows prompt after the first time)"/></CheckBox><TextBox x:Name="AlwaysAdminNote" Style="{StaticResource Desc}" Text=""/><WrapPanel Margin="0,0,0,2"><Button x:Name="OpenTaskbarBtn" Content="Open Windows taskbar settings" Padding="10,4" Margin="0,0,6,6" Click="OpenTaskbarSettings_Click"/></WrapPanel></StackPanel>
</Expander>
<Expander x:Name="CardClients" Header="CLIENTS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="How the app finds your EVE clients, and what it does with the ones you aren't using."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Client Scan Interval (ms)"/><TextBox x:Name="RefreshBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Auto-Minimize Delay (s)"/><TextBox x:Name="AutoMinDelayBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Scan interval 500 to 10000 ms: how often it looks for new or closed clients (focus changes are picked up instantly either way). Delay 0 to 600 s, where 0 is straight away."/><CheckBox x:Name="AutoMinBox"><TextBlock TextWrapping="Wrap" Text="Auto-minimize the other EVE clients so they stop using the graphics card and processor"/></CheckBox><CheckBox x:Name="KeepLastBox"><TextBlock TextWrapping="Wrap" Text="When EVE isn't in front, keep the client I used last visible"/></CheckBox><CheckBox x:Name="MinOnStartBox"><TextBlock TextWrapping="Wrap" Text="Also minimize clients that haven't been in front yet (loading, or on the login screen)"/></CheckBox><TextBox Style="{StaticResource Desc}" Text="Windows animates a minimized client back up when you switch to it, so that switch is a little slower."/><TextBox Style="{StaticResource FieldLabel}" Text="Never Minimize These Clients"/><TextBox x:Name="NoMinText" Style="{StaticResource Desc}" Text="No characters known yet. Log in an EVE client, then reopen settings." Visibility="Collapsed"/><StackPanel x:Name="MinChecks"/></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageThumbs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardSize" Header="SIZE AND OPACITY" Style="{StaticResource Card}">
<StackPanel><CheckBox x:Name="SameSizeBox"><TextBlock TextWrapping="Wrap" Text="Keep all thumbnails the same size (resize one and they all follow)"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Default / Shared Width"/><TextBox x:Name="WidthBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Default / Shared Height"/><TextBox x:Name="HeightBox"/></StackPanel><StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBox x:Name="OpacityLabel" Style="{StaticResource FieldLabel}" Text="Thumbnail Opacity: 60%"/><Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="60" ValueChanged="OpacitySlider_ValueChanged"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Width 120 to 1200 px. Height 0 = automatic 16:9, otherwise 45 to 1200. A lower opacity is more see-through."/></StackPanel>
</Expander>
<Expander x:Name="CardLabel" Header="TEXT LABEL" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="The character name drawn on each thumbnail, and the box behind it."/><StackPanel Orientation="Horizontal"><CheckBox x:Name="LabelsBox" Margin="0,0,24,6"><TextBlock TextWrapping="Wrap" Text="Show character names on thumbnails"/></CheckBox><CheckBox x:Name="BoldBox" Margin="0,0,0,6"><TextBlock TextWrapping="Wrap" Text="Bold"/></CheckBox></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Font"/><ComboBox x:Name="FontBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Font Size"/><TextBox x:Name="FontSizeBox"/></StackPanel><StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Position"/><ComboBox x:Name="LabelPositionBox"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Text Colour"/><local:ColourField x:Name="LabelColourBox" FallbackHex="#FFFFFF"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Background Colour"/><local:ColourField x:Name="LabelBgBox" FallbackHex="#0C0C0E"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox x:Name="LabelOpacityLabel" Style="{StaticResource FieldLabel}" Text="Text Opacity: 60%"/><Slider x:Name="LabelOpacitySlider" Minimum="10" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="60" ValueChanged="LabelOpacitySlider_ValueChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox x:Name="BgOpacityLabel" Style="{StaticResource FieldLabel}" Text="Background Opacity: 60%"/><Slider x:Name="LabelBgOpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="60" ValueChanged="BgOpacitySlider_ValueChanged"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Horizontal Offset (px)"/><TextBox x:Name="OffsetXBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Vertical Offset (px)"/><TextBox x:Name="OffsetYBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Offsets run from -300 to 300. A background opacity of 0% means no box behind the text. One character can have its own colour, size and opacity under Per-Character Overrides, further down this page."/></StackPanel>
</Expander>
<Expander x:Name="CardActiveBorder" Header="BORDERS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="The border drawn around each live thumbnail: one for the client you're in, one for the others, and the colour an alert flashes."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Client You're In"/><CheckBox x:Name="HighlightBox"><TextBlock TextWrapping="Wrap" Text="Show a border on the active client's thumbnail"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Colour"/><local:ColourField x:Name="ColourBox" FallbackHex="#F97316"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Width (px)"/><TextBox x:Name="ActiveWidthBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Style"/><ComboBox x:Name="ActiveStyleBox"/></StackPanel></Grid></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Other Clients"/><CheckBox x:Name="InactiveBox"><TextBlock TextWrapping="Wrap" Text="Show a border on inactive clients' thumbnails"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Colour"/><local:ColourField x:Name="InactiveColourBox" FallbackHex="#6F6F7D"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Width (px)"/><TextBox x:Name="InactiveWidthBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Style"/><ComboBox x:Name="InactiveStyleBox"/></StackPanel></Grid></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Alert Flash Colour"/><local:ColourField x:Name="NotifyColourBox" FallbackHex="#F87171"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource Desc}" Text="The colour a thumbnail's border flashes when an alert fires. Turn the flash on under Alerts." Margin="0,24,0,0"/></StackPanel></Grid></StackPanel>
</Expander>
<Expander x:Name="CardCharacter" Header="PER-CHARACTER OVERRIDES" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Pick a character to give its thumbnail its own label, colour, size and opacity. Leave a field empty or at 0 to use the defaults above."/><TextBox x:Name="NoCharText" Style="{StaticResource Desc}" Text="No characters known yet. Log in an EVE client, then reopen settings." Visibility="Collapsed"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Character"/><ComboBox x:Name="CharBox" SelectionChanged="CharBox_SelectionChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Preview"/><Border Background="{StaticResource BrushInput}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,0,8" HorizontalAlignment="Left"><TextBlock x:Name="LabelPreview" FontWeight="SemiBold" FontSize="14" Text="Character name"/></Border></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Label Text"/><TextBox x:Name="LabelBox" TextChanged="LabelBox_TextChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Label Colour"/><local:ColourField x:Name="CharColourBox" FallbackHex="#FFFFFF" AllowEmpty="True"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Label Size"/><TextBox x:Name="CharLabelSizeBox" TextChanged="CharLabelStyle_TextChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Label Opacity (%)"/><TextBox x:Name="CharLabelOpacityBox" TextChanged="CharLabelStyle_TextChanged"/></StackPanel><StackPanel Grid.Column="2" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Thumbnail Width"/><TextBox x:Name="CharWidthBox"/></StackPanel><StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Thumbnail Height"/><TextBox x:Name="CharHeightBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Label text empty = the character name. Label size 6 to 72, label opacity 10 to 100, thumbnail width 80 to 1600, height 45 to 1200 (0 = automatic 16:9). Width and height are ignored while all thumbnails are kept the same size (Size And Opacity, above)."/></StackPanel>
</Expander>

<Expander x:Name="CardInteraction" Header="INTERACTION AND HIDING" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Mouse behaviour for switching, moving and resizing thumbnails, and the rules that hide them. Hold Shift and drag with the left mouse button to move a thumbnail; drag the small triangle in its bottom-right corner to resize it. Thumbnails are overlays: clicking one never takes focus from the game."/><CheckBox x:Name="ClickableBox"><TextBlock TextWrapping="Wrap" Text="Thumbnails are clickable (untick to switch with the hotkeys only)"/></CheckBox><CheckBox x:Name="LoginClickableBox"><TextBlock TextWrapping="Wrap" Text="Thumbnails of clients that aren't logged in yet are clickable"/></CheckBox><CheckBox x:Name="LockBox"><TextBlock TextWrapping="Wrap" Text="Lock thumbnail positions and sizes (no moving or resizing)"/></CheckBox><CheckBox x:Name="SnapBox"><TextBlock TextWrapping="Wrap" Text="Snap thumbnails together when dragged close"/></CheckBox><CheckBox x:Name="OnTopBox"><TextBlock TextWrapping="Wrap" Text="Keep thumbnails always on top of other windows"/></CheckBox><CheckBox x:Name="HideActiveBox"><TextBlock TextWrapping="Wrap" Text="Hide the thumbnail of the client I'm currently in"/></CheckBox><CheckBox x:Name="HideUnfocusedBox"><TextBlock TextWrapping="Wrap" Text="Hide all thumbnails while EVE isn't the window in front"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Snap Distance (px)"/><TextBox x:Name="SnapDistBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Delay Before Hiding (ms)"/><TextBox x:Name="HideDelayBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Snap distance 1 to 100 px. Hide delay 0 to 5000 ms: a short delay stops thumbnails flickering when you click between windows."/></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageGroups" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardRoster" Header="CHARACTERS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="The characters that get a thumbnail, kept in groups. Pick the group to use, type a character name on each line and press + to add another line. Tick a line to show its thumbnail, untick it to hide it."/><TextBox Style="{StaticResource FieldLabel}" Text="Group In Use" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ThumbGroupBox" Margin="0" SelectionChanged="ThumbGroup_SelectionChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="NewThumbGroupBtn" Content="New" Padding="10,4" Margin="0,0,5,0" Click="NewThumbGroup_Click"/><Button x:Name="RenameThumbGroupBtn" Content="Rename" Padding="10,4" Margin="0,0,5,0" Click="RenameThumbGroup_Click"/><Button x:Name="DeleteThumbGroupBtn" Content="Delete" Padding="10,4" Style="{StaticResource DangerButton}" Click="DeleteThumbGroup_Click"/></StackPanel></Grid><StackPanel x:Name="ClientChecks"/><WrapPanel Margin="0,0,0,2"><Button x:Name="AddThumbBtn" Content="+  Add character" Padding="10,4" Margin="0,0,6,6" Click="AddThumb_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="SelectAllBtn" Content="Select all" Padding="10,4" Margin="0,0,6,6" Click="SelectAll_Click" /><Button x:Name="SelectNoneBtn" Content="Select none" Padding="10,4" Margin="0,0,6,6" Click="SelectNone_Click" /></WrapPanel><CheckBox x:Name="LoginScreensBox"><TextBlock TextWrapping="Wrap" Text="Login screens (clients that aren't logged in yet)"/></CheckBox><CheckBox x:Name="ShowUnlistedBox"><TextBlock TextWrapping="Wrap" Text="Also show thumbnails for logged-in characters that aren't in this group"/></CheckBox></StackPanel>
</Expander>
<Expander x:Name="CardScan" Header="FIND RUNNING CLIENTS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Scans every running EVE client for its character name and lists them here. Tick the ones you want and add them to the group above. Clients still on the login screen have no name yet."/><WrapPanel Margin="0,0,0,2"><Button x:Name="ScanBtn" Content="Scan running clients" Padding="10,4" Margin="0,0,6,6" Click="Scan_Click" /><Button x:Name="ScanAllBtn" Content="Select all" Padding="10,4" Margin="0,0,6,6" Click="ScanSelectAll_Click" /><Button x:Name="AddScannedBtn" Content="Add selected" Padding="10,4" Margin="0,0,6,6" Click="AddScanned_Click" Style="{StaticResource PrimaryButton}" /></WrapPanel><TextBox x:Name="ScanNote" Style="{StaticResource Desc}" Text="Press Scan to look for clients."/><Border x:Name="ScanBox" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="3" Background="{StaticResource BrushInput}" Padding="12,10,12,2" MinHeight="46" Margin="0,0,0,12"><ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ScanHost"/></ScrollViewer></Border></StackPanel>
</Expander>
<Expander x:Name="CardClientOrder" Header="CLIENT ORDER AND POSITIONS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Your clients are numbered 1st, 2nd, 3rd and so on. That order is used by the Next / Previous hotkeys, by the client hotkeys (1st client, 2nd client, ...) and, when positions are saved by client, to decide which spot on screen each thumbnail takes. Set the order first, then choose how positions are remembered."/><TextBox Style="{StaticResource FieldLabel}" Text="1. How Clients Are Ordered"/><RadioButton x:Name="OrderAutoRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBlock TextWrapping="Wrap" Text="Automatic: in the order the clients were opened. A client you close and reopen goes to the end."/></RadioButton><RadioButton x:Name="OrderSavedRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBlock TextWrapping="Wrap" Text="Saved: the order is remembered. A client you close and reopen goes back to its old place, and its thumbnail position stays reserved while it is closed. New characters are added to the end."/></RadioButton><RadioButton x:Name="OrderManualRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBlock TextWrapping="Wrap" Text="Manual: you choose the order with the list below. New characters start unticked and only count once you tick them."/></RadioButton><StackPanel x:Name="OrderSavedPanel" Margin="0,12,0,0" Visibility="Collapsed"><TextBox Style="{StaticResource FieldLabel}" Text="Saved Order" /><TextBox x:Name="SavedOrderText" Style="{StaticResource Desc}" Text=""/><TextBox x:Name="OrderResetNote" Style="{StaticResource Desc}" Foreground="{StaticResource BrushAccentHover}" Visibility="Collapsed" Text=""/><WrapPanel Margin="0,0,0,2"><Button x:Name="ResetOrderBtn" Content="Reset order" Padding="10,4" Margin="0,0,6,6" Click="ResetOrder_Click" /><Button x:Name="CancelResetBtn" Content="Cancel reset" Padding="10,4" Margin="0,0,6,6" Click="CancelReset_Click" Visibility="Collapsed" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Reset order clears the saved list the next time all your EVE clients are closed (or none are open). It then builds up again in the order the clients are opened, like the first time. Until then nothing changes."/></StackPanel><StackPanel x:Name="OrderListPanel" Margin="0,12,0,0"><TextBox Style="{StaticResource Desc}" Text="Tick a character to put it in the order, then use the arrows to move it. Characters that aren't ticked come after the ticked ones, in the order they were opened. A client still on the login screen takes the first free place in the list, so it is already in position when the character logs in."/><WrapPanel Margin="0,0,0,2"><Button x:Name="OrderTickAllBtn" Content="Tick all" Padding="10,4" Margin="0,0,6,6" Click="OrderTickAll_Click" /><Button x:Name="OrderUntickAllBtn" Content="Untick all" Padding="10,4" Margin="0,0,6,6" Click="OrderUntickAll_Click" /></WrapPanel><TextBox x:Name="NoOrderText" Style="{StaticResource Desc}" Visibility="Collapsed" Text="No characters known yet. Log in an EVE client, then reopen settings."/><StackPanel x:Name="OrderChecks"/></StackPanel><Border BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Margin="0,4,0,8"/><TextBox Style="{StaticResource FieldLabel}" Text="2. Where Thumbnail Positions Are Remembered"/><RadioButton x:Name="ModeCharacterRadio" GroupName="PositionMode" Checked="PositionMode_Changed"><TextBlock TextWrapping="Wrap" Text="By character: a character's thumbnail stays where you put it, whichever client it logs in on."/></RadioButton><RadioButton x:Name="ModeClientRadio" GroupName="PositionMode" Checked="PositionMode_Changed"><TextBlock TextWrapping="Wrap" Text="By client: the 1st client in the order always uses the 1st position, the 2nd the 2nd, and so on (login screens included). Works best with Saved or Manual order."/></RadioButton><TextBox x:Name="OrderPositionNote" Style="{StaticResource Desc}" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,8" Visibility="Collapsed" Text="Positions are saved by client, so each thumbnail follows its client's place in the order above. With Automatic order, a client you close and reopen goes to the end and the others move up a place, so thumbnails change position. Choose Saved or Manual to keep every client in its own place."/><CheckBox x:Name="InheritBox" Margin="0,2,0,8"><TextBlock TextWrapping="Wrap" Text="A new character takes the position and size of the login screen it replaces"/></CheckBox><WrapPanel Margin="0,0,0,2"><Button x:Name="RecoverBtn" Content="Recover off-screen thumbnails" Padding="10,4" Margin="0,0,6,6" Click="Recover_Click" /><Button x:Name="ResetPosBtn" Content="Reset all positions" Padding="10,4" Margin="0,0,6,6" Click="ResetPositions_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Recover moves any thumbnail that ended up off the screen back onto your main monitor. It also happens by itself when your monitors change."/></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageHotkeys" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardCycling" Header="CYCLING" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Click a box, then press the key, mouse button or combination you want. Use the ✕ to clear it. Next and previous follow the client order (set under Grouping &gt; Client Order And Positions), and skip any client that is not responding."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Next Client"/><local:HotkeyField x:Name="ForwardBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Previous Client"/><local:HotkeyField x:Name="BackBox"/></StackPanel></Grid><CheckBox x:Name="CycleLoginBox"><TextBlock TextWrapping="Wrap" Text="Include clients that are still on the login screen"/></CheckBox></StackPanel>
</Expander>

<Expander x:Name="CardHotkeyOptions" Header="HOTKEY OPTIONS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Hotkeys can be any key or mouse button, with or without modifiers. These options say where they work and what happens to the key."/><CheckBox x:Name="HotkeysOnlyEveBox"><TextBlock TextWrapping="Wrap" Text="Hotkeys only work while an EVE client is the window in front"/></CheckBox><CheckBox x:Name="PassThroughBox"><TextBlock TextWrapping="Wrap" Text="Let the key or button reach the program as well (do not swallow it)"/></CheckBox><TextBox Style="{StaticResource Desc}" Text="A single key with no modifier (like T) is taken over everywhere unless you tick the first option, and it stops typing that letter. Right-side modifiers are saved as RCtrl, RAlt, RShift and RWin; the left-side ones match either side."/></StackPanel>
</Expander>
<Expander x:Name="CardSlotKeys" Header="CLIENT HOTKEYS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="A hotkey for the 1st client in the client order, the 2nd, and so on (clients still on the login screen count). Press + to add a line for another client. Keep several sets in groups and pick the group to use."/><TextBox Style="{StaticResource FieldLabel}" Text="Group In Use" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SlotGroupBox" Margin="0" SelectionChanged="SlotGroup_SelectionChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="NewSlotGroupBtn" Content="New" Padding="10,4" Margin="0,0,5,0" Click="NewSlotGroup_Click"/><Button x:Name="RenameSlotGroupBtn" Content="Rename" Padding="10,4" Margin="0,0,5,0" Click="RenameSlotGroup_Click"/><Button x:Name="DeleteSlotGroupBtn" Content="Delete" Padding="10,4" Style="{StaticResource DangerButton}" Click="DeleteSlotGroup_Click"/></StackPanel></Grid><StackPanel x:Name="SlotHotkeyHost"/><WrapPanel Margin="0,0,0,2"><Button x:Name="AddSlotBtn" Content="+  Add client" Padding="10,4" Margin="0,0,6,6" Click="AddSlot_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="RemoveSlotBtn" Content="-  Remove last" Padding="10,4" Margin="0,0,6,6" Click="RemoveSlot_Click"/></WrapPanel></StackPanel>
</Expander>
<Expander x:Name="CardCharActions" Header="PER-CHARACTER HOTKEY AND SWITCHING" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Pick a character to give it a key that jumps straight to its client (a key, mouse button or combination), and to set what happens to its client window when you switch to it or away from it."/><TextBox x:Name="NoCharText2" Style="{StaticResource Desc}" Text="No characters known yet. Log in an EVE client, then reopen settings." Visibility="Collapsed"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Character"/><ComboBox x:Name="CharBox2" SelectionChanged="CharBox_SelectionChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Jump-To Hotkey"/><local:HotkeyField x:Name="CharHotkeyBox"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="When I Switch To This Client"/><ComboBox x:Name="CharActionBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><CheckBox x:Name="CharMinLeaveBox" Margin="0,26,0,0"><TextBlock TextWrapping="Wrap" Text="Minimise this client when I switch away from it"/></CheckBox></StackPanel></Grid></StackPanel>
</Expander>
<Expander x:Name="CardSkipped" Header="SKIPPED CLIENTS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Tick a client to make the next / previous hotkeys skip it. You can still switch to it by clicking its thumbnail or with its own hotkey."/><TextBox Style="{StaticResource Desc}" Foreground="{StaticResource BrushAccentHover}" Text="Note: the thumbnail of a skipped client is marked with a red X."/><TextBox x:Name="NoSkipText" Style="{StaticResource Desc}" Visibility="Collapsed" Text="No characters known yet. Log in an EVE client, then reopen settings."/><StackPanel x:Name="SkipChecks"/></StackPanel>
</Expander>
<Expander x:Name="CardProfileKeys" Header="PROFILE HOTKEYS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Switch profiles from the keyboard. The first box belongs to the profile shown at the top."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Switch To This Profile"/><local:HotkeyField x:Name="ProfileHotkeyBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Next Profile"/><local:HotkeyField x:Name="NextProfileBox"/></StackPanel><StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Previous Profile"/><local:HotkeyField x:Name="PrevProfileBox"/></StackPanel></Grid></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageAlerts" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardNotifyMain" Header="NOTIFICATIONS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Alerts for the events switched on under Events To Watch. They only fire for logged-in clients, and only while log monitoring is on. Tick as many ways of being alerted as you like."/><CheckBox x:Name="NotifyEnabledBox"><TextBlock TextWrapping="Wrap" Text="Enable Notifications"/></CheckBox><CheckBox x:Name="NotifySkipActiveBox"><TextBlock TextWrapping="Wrap" Text="Don't alert me about the client I'm currently in"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Cooldown Between Alerts (s)"/><TextBox x:Name="NotifyCooldownBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Flash For (s)"/><TextBox x:Name="NotifySecondsBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="The same alert for the same character is not repeated within the cooldown (0 to 3600). Flash time 1 to 120."/><CheckBox x:Name="NotifyFlashBox"><TextBlock TextWrapping="Wrap" Text="Flash the client's thumbnail border (the colour is set under Thumbnails &gt; Borders)"/></CheckBox><CheckBox x:Name="NotifyToastBox"><TextBlock TextWrapping="Wrap" Text="Show a Windows notification"/></CheckBox><CheckBox x:Name="NotifySoundBox"><TextBlock TextWrapping="Wrap" Text="Play a sound"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Sound"/><ComboBox x:Name="NotifySoundCombo"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Custom Sound File (.wav)"/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NotifySoundFileBox" Margin="0"/><Button x:Name="BrowseSoundBtn" Grid.Column="1" Content="..." Padding="12,4" Margin="6,0,0,0" Click="BrowseSound_Click"/></Grid></StackPanel></Grid><CheckBox x:Name="NotifySpeakBox"><TextBlock TextWrapping="Wrap" Text="Speak the alert out loud (Windows text-to-speech)"/></CheckBox><WrapPanel Margin="0,0,0,2"><Button x:Name="TestNotifyBtn" Content="Send a test alert" Padding="10,4" Margin="0,0,6,6" Click="TestNotify_Click"/></WrapPanel></StackPanel>
</Expander>
<Expander x:Name="CardLogMain" Header="LOG MONITORING" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Reads the log files the EVE client writes for you (Documents\EVE\logs) to spot events. It only reads them: it never sends anything to the game. Leave the folders empty to use the standard ones under Documents\EVE\logs."/><CheckBox x:Name="LogEnabledBox"><TextBlock TextWrapping="Wrap" Text="Enable Log Monitoring"/></CheckBox><TextBox x:Name="LogStatusText" Style="{StaticResource Desc}" Text=""/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Check For New Lines Every (ms)"/><TextBox x:Name="LogPollBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource Desc}" Text="250 to 10000" Margin="0,24,0,0"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Game Logs Folder"/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GameFolderBox" Margin="0"/><Button Grid.Column="1" Content="Browse" Padding="10,4" Margin="6,0,0,0" Click="BrowseGame_Click"/></Grid></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Chat Logs Folder"/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatFolderBox" Margin="0"/><Button Grid.Column="1" Content="Browse" Padding="10,4" Margin="6,0,0,0" Click="BrowseChat_Click"/></Grid></StackPanel></Grid><CheckBox x:Name="LogSystemBox"><TextBlock TextWrapping="Wrap" Text="Show the solar system next to the name on each thumbnail (reads the Local chat log)"/></CheckBox></StackPanel>
</Expander>
<Expander x:Name="CardLogEvents" Header="EVENTS TO WATCH" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="What counts as an event."/><CheckBox x:Name="LogAttackBox"><TextBlock TextWrapping="Wrap" Text="Under attack: incoming damage in the combat log"/></CheckBox><CheckBox x:Name="LogMiningBox"><TextBlock TextWrapping="Wrap" Text="Mining has gone quiet"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Quiet For (s)"/><TextBox x:Name="LogMiningSecondsBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource Desc}" Text="Raises an alert when no mining lines have been logged for this long (10 or more)." Margin="0,24,0,0"/></StackPanel></Grid><TextBox Style="{StaticResource FieldLabel}" Text="Keywords"/><TextBox x:Name="LogKeywordsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><TextBox Style="{StaticResource Desc}" Text="One phrase per line. A game-log line containing one of them raises an alert (for example: warp scramble)."/></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageMemory" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardMemoryNow" Header="MEMORY" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Your PC's memory right now. Trim Programs asks Windows to take back memory that programs aren't actively using, so it can be used for something else. Windows manages memory well on its own, so this mostly helps when RAM is nearly full. Restart Windows Explorer closes and restarts the taskbar, the desktop and any File Explorer windows, which also gives back the memory Explorer has built up. The grey line under each button is an estimate of what it would free; the real amount is shown once it has run."/><TextBox x:Name="MemUsageText" Style="{StaticResource SelectableText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" Text="Reading memory..."/><Border x:Name="MemTrack" Height="18" Margin="0,0,0,8" CornerRadius="3" Background="{StaticResource BrushInput}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1"><Border x:Name="MemFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource BrushAccent}"/></Border><TextBox x:Name="MemCommitText" Style="{StaticResource SelectableText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,4" Text=""/><TextBox x:Name="MemStatsText" Style="{StaticResource SelectableText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12" Text=""/><WrapPanel Margin="0,0,0,2"><StackPanel Margin="0,0,8,2" Width="200"><Button x:Name="MemTrimBtn" Content="Trim Programs" Padding="10,4" Margin="0" HorizontalAlignment="Left" Click="MemTrim_Click"/><TextBox x:Name="MemTrimEstimate" Style="{StaticResource Desc}" FontSize="11.5" Margin="1,4,0,4" ToolTip="An estimate of what Trim Programs would free, from the programs it would trim right now. After you have trimmed once it uses what that trim really gave back." Text="Estimating..."/></StackPanel><StackPanel Margin="0,0,8,2" Width="200"><Button x:Name="MemCacheBtn" Content="Clear system cache" Padding="10,4" Margin="0" HorizontalAlignment="Left" Click="MemCache_Click"/><TextBox x:Name="MemCacheEstimate" Style="{StaticResource Desc}" FontSize="11.5" Margin="1,4,0,4" ToolTip="Cached files can be dropped, and unsaved (modified) data is written to disk. Windows already counts cached files as available memory, so the Memory in use figure barely changes." Text="Estimating..."/></StackPanel><StackPanel Margin="0,0,8,2" Width="200"><Button x:Name="MemClipboardBtn" Content="Clear clipboard" Padding="10,4" Margin="0" HorizontalAlignment="Left" Click="MemClipboard_Click"/><TextBox x:Name="MemClipEstimate" Style="{StaticResource Desc}" FontSize="11.5" Margin="1,4,0,4" ToolTip="The size of the text or picture on the clipboard right now." Text="Estimating..."/></StackPanel><StackPanel Margin="0,0,8,2"><Button x:Name="MemExplorerBtn" Content="Restart Windows Explorer" Padding="10,4" Margin="0" HorizontalAlignment="Left" Click="RestartExplorer_Click"/></StackPanel></WrapPanel><TextBox x:Name="MemResultText" Style="{StaticResource AutoHideText}" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,4" Text=""/><TextBox x:Name="MemSessionText" Style="{StaticResource AutoHideText}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12" Text=""/><TextBox x:Name="MemAdminNote" Style="{StaticResource Desc}" Visibility="Collapsed" Text="Clearing the system cache needs administrator rights, so it is switched off while the app runs normally. Trimming works for your own programs either way; as administrator it also reaches programs that other accounts started. Restart as administrator can set the app to start this way every time, so you only do it once."/><WrapPanel x:Name="MemAdminPanel" Margin="0,0,0,6" Visibility="Collapsed"><Button x:Name="RestartAdminBtn" Content="Restart as administrator" Padding="10,4" Margin="0,0,6,6" Click="RestartAdmin_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="The average, lowest and highest figures come from the readings taken while this page is open and by the automatic checks, not from the whole day."/></StackPanel>
</Expander>
<Expander x:Name="CardMemoryAuto" Header="SETTINGS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Automatic cleaning. Everything here is off until you switch it on, and nothing runs in the background while it is off. These settings are for the whole app, not for a profile."/><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemTrimEveryBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Trim programs every"/></CheckBox><TextBox x:Name="MemTrimMinutesBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemCacheEveryBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Clear system cache every"/></CheckBox><TextBox x:Name="MemCacheMinutesBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="28,0,0,8"><CheckBox x:Name="MemCacheOnlyLowBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="...but only while free memory is below"/></CheckBox><TextBox x:Name="MemCacheLowPercentBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="%" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><CheckBox x:Name="MemTrimAboveBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Trim programs when memory use exceeds"/></CheckBox><TextBox x:Name="MemTrimPercentBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="%" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><CheckBox x:Name="MemCacheAboveBox" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Clear system cache when memory use exceeds"/></CheckBox><TextBox x:Name="MemCachePercentBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="%" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><CheckBox x:Name="MemLimitsBox"><TextBlock TextWrapping="Wrap" Text="Trim a program when it goes over its own limit"/></CheckBox><TextBox x:Name="MemLimitsText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><TextBox Style="{StaticResource Desc}" Text="One program per line as name=megabytes, for example: chrome=1500 (names as shown on the Details tab of Task Manager, without .exe; 50 to 65536 MB). All the processes of that name are added together, and each program is trimmed at most once every 3 minutes. The never-trim list and the program in front still win."/><TextBox Style="{StaticResource Desc}" Text="Minutes: 1 to 1440. Limits: 50 to 99 percent. While a limit is switched on, memory use is checked every 30 seconds, and it cleans at most once every 3 minutes, so a PC that really needs all its RAM isn't cleaned over and over. The 'only while free memory is below' box (5 to 90 percent) stops the scheduled cache clearing from running when there is plenty of free memory; the usage limit above it is separate."/><CheckBox x:Name="MemNotifyBox"><TextBlock TextWrapping="Wrap" Text="Show a Windows notification when it cleans by itself"/></CheckBox></StackPanel>
</Expander>
<Expander x:Name="CardMemoryTop" Header="TOP PROGRAMS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="The 10 programs using the most memory, refreshed every 10 seconds while this page is open (nothing is read while it is closed or the window is minimised). A program with several processes is added together. The arrow compares with about a minute ago; a yellow 'growing' tag marks a program whose memory has kept rising for several minutes, which can mean a leak. These trends build up only while this page is open. Trim asks Windows to take back that program's idle memory now. Never trim puts it on the never-trim list under Exclusions, below (press Apply or Save to keep that)."/><StackPanel x:Name="TopProgsHost"/><TextBox x:Name="TopProgsNote" Style="{StaticResource Desc}" Margin="0,6,0,12" Text="Reading programs..."/></StackPanel>
</Expander>
<Expander x:Name="CardMemoryKeep" Header="EXCLUSIONS" Style="{StaticResource Card}">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="The program you are using at that moment is never trimmed, and neither are Windows' own core processes or the Windows audio engine."/><TextBox Style="{StaticResource FieldLabel}" Text="Smallest Program To Trim (MB)" /><TextBox x:Name="MemMinMbBox" /><TextBox Style="{StaticResource Desc}" Text="Programs using less memory than this are skipped, because trimming them gains almost nothing. 0 trims everything (0 to 4096). This applies to Trim Programs and automatic cleaning, not to the Trim button next to a program."/><TextBox Style="{StaticResource FieldLabel}" Text="EVE Clients" /><RadioButton x:Name="MemEveNeverRadio" GroupName="MemEve"><TextBlock TextWrapping="Wrap" Text="Never trim EVE clients (recommended)"/></RadioButton><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><RadioButton x:Name="MemEveIdleRadio" GroupName="MemEve" Margin="0" VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" Text="Trim EVE clients in the background after they have been idle for"/></RadioButton><TextBox x:Name="MemEveIdleBox" Width="64" Margin="10,0,8,0" VerticalAlignment="Center"/><TextBlock Text="minutes" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/></StackPanel><RadioButton x:Name="MemEveAllRadio" GroupName="MemEve"><TextBlock TextWrapping="Wrap" Text="Trim EVE clients like any other program"/></RadioButton><TextBox Style="{StaticResource Desc}" Text="Trimming a background client frees its memory, but when you switch back to it Windows has to bring that memory back in, which can cause a short stutter. The idle option avoids that for the clients you switch between: the one you are in is never trimmed, and a background client is only trimmed once it has been out of front for the time you set (1 to 1440 minutes)."/><TextBox Style="{StaticResource FieldLabel}" Text="Never Trim These Programs" /><TextBox x:Name="MemExcludeBox" /><TextBox Style="{StaticResource Desc}" Text="Program names as shown on the Details tab of Task Manager, without .exe, separated by commas. For example: discord, obs64. The Never trim button in Top Programs adds to this list."/></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch"><Expander x:Name="CardAbout" Header="ABOUT" Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Image Source="/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="EVE-IronWorks-Preview" FontWeight="Bold" FontSize="17" Foreground="White"/><TextBox x:Name="VersionText" Style="{StaticResource SelectableText}" Text="v0.0.0" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/><TextBlock FontSize="12" Margin="0,3,0,0"><Hyperlink Style="{StaticResource CreditLink}" NavigateUri="https://autz-ironworks.vercel.app/#/home" RequestNavigate="Website_RequestNavigate">by AUTZ IronWorks · From planets to profit</Hyperlink></TextBlock></StackPanel></StackPanel><TextBox Style="{StaticResource Desc}" Text="Also known as EVE-IW-Preview (the exe, the GitHub repository and posts). Live previews of your running EVE Online clients and instant client switching. It only shows a picture of each client and brings the window to the front: it never sends keys or mouse clicks to EVE."/></StackPanel></Expander><Expander x:Name="CardWhatsNew" Header="WHAT'S NEW" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The pop-up with the version and the latest changes."/><TextBox Style="{StaticResource FieldLabel}" Text="Show The Pop-Up" /><ComboBox x:Name="WhatsNewCombo" /><WrapPanel Margin="0,0,0,2"><Button x:Name="ViewChangelogBtn" Content="View changelog" Padding="10,4" Margin="0,0,6,6" Click="ViewChangelog_Click" /></WrapPanel></StackPanel></Expander><Expander x:Name="CardFiles" Header="FILES" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Profiles, the active-profile file and the diagnostics log live here."/><TextBox x:Name="FolderText" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource BrushText}"/><WrapPanel Margin="0,0,0,2"><Button x:Name="OpenFolderBtn" Content="Open folder" Padding="10,4" Margin="0,0,6,6" Click="OpenFolder_Click" /><Button x:Name="OpenLogBtn" Content="Open log" Padding="10,4" Margin="0,0,6,6" Click="OpenLog_Click" /></WrapPanel></StackPanel></Expander><Expander x:Name="CardDiagnostics" Header="DIAGNOSTICS (ADMIN LOG)" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Detailed logging writes every step the app takes to debug.log, with millisecond timestamps: each hotkey press, each focus attempt and which method worked, every minimise, restore and maximise it sends to a client, thumbnails shown, hidden, created and closed, and every focus change Windows reports. Turn it on, reproduce the problem, then open the log. It is written in the background, so it doesn't slow switching down. This setting is app-wide, not per profile."/><CheckBox x:Name="DebugLogBox"><TextBlock TextWrapping="Wrap" Text="Detailed logging"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Log File" /><RadioButton x:Name="DebugContinuousRadio" GroupName="DebugMode"><TextBlock TextWrapping="Wrap" Text="One continuous log (debug.log) that carries on each time logging is turned on"/></RadioButton><RadioButton x:Name="DebugSessionRadio" GroupName="DebugMode"><TextBlock TextWrapping="Wrap" Text="A new log every time logging is turned on (debug-DATE_TIME.log), so each test is its own file"/></RadioButton><WrapPanel Margin="0,0,0,2"><Button x:Name="OpenDebugLogBtn" Content="Open debug log" Padding="10,4" Margin="0,0,6,6" Click="OpenDebugLog_Click" /><Button x:Name="ClearDebugLogBtn" Content="Clear debug log" Padding="10,4" Margin="0,0,6,6" Click="ClearDebugLog_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Privacy: the logs never contain character names, profile names, the titles of other windows, your Windows user name, your PC name or folder paths. A character or profile name shows as a short code (for example Pilot-3FA9C1): the same name always gives the same code on this PC, but the name can't be worked out from it, so a log can be sent to someone safely. Also in the tray menu: Detailed Logging and Open Debug Log. Open debug log opens the newest one. The continuous log rolls over to debug.old.log at about 4 MB; the newest 20 separate logs are kept. Changing the setting while logging is on carries on in the other kind of file straight away."/></StackPanel></Expander></StackPanel></ScrollViewer>
            </Grid>

            <!-- footer: search, status, buttons -->
            <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Padding="22,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="230">
                        <TextBox x:Name="SearchBox" Margin="0" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Search settings ..." Foreground="{StaticResource BrushDim}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                    <TextBox x:Name="StatusText" Style="{StaticResource SelectableText}" Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ResetBtn" Content="Reset" Width="82" Margin="0,0,16,0" Click="Reset_Click" ToolTip="Put this profile's settings back to their defaults"/>
                        <Button x:Name="ApplyBtn" Content="Apply" Width="82" Margin="0,0,8,0" Click="Apply_Click" ToolTip="Use these settings now, without saving them"/>
                        <Button x:Name="SaveBtn" Content="Save" Width="82" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Save these settings to the config file"/>
                        <Button x:Name="CloseBtn" Content="Close" Width="82" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
