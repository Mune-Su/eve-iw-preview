<Window x:Class="AUTZ.IronWorks.Preview.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AUTZ.IronWorks.Preview.Views"
        Title="EVE-IronWorks-Preview Configuration"
        Icon="/Assets/app.ico"
        Width="1100" Height="820" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}"
        FontFamily="Inter, Segoe UI" FontSize="13"
        ShowInTaskbar="False" Topmost="True">
    <!-- Same layout as the website: a sidebar with the brand and the menu on the left, the page on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== sidebar ===== -->
        <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,20,14,18">
                    <Image Source="/Assets/logo.png" Width="40" Height="40" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,8"/>
                    <TextBlock Text="EVE-IronWorks" FontSize="19" FontWeight="Black" Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="PREVIEW" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource BrushAccent}" Margin="0,1,0,0"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"><Hyperlink Style="{StaticResource CreditLink}" NavigateUri="https://autz-ironworks.vercel.app/#/home" RequestNavigate="Website_RequestNavigate">by AUTZ IronWorks · From planets to profit</Hyperlink></TextBlock>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" Margin="12,0,12,10"/>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Margin="14,0,14,0" Padding="4,12,4,14">
                    <TextBox x:Name="SidebarVersion" Style="{StaticResource SelectableText}" Text="v0.0.0" FontSize="11" Foreground="{StaticResource BrushDim}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== right side: heading + profile bar, page, footer ===== -->
        <Grid Grid.Column="1" Background="{StaticResource BrushBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- viewhead: small caps label + page title, and the profile controls (like the website's toollinks) -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Padding="22,16,22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CONFIGURATION" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock x:Name="PageTitleText" Text="General" FontSize="26" FontWeight="Bold" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="PROFILE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileBox" Width="170" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="ProfileBox_SelectionChanged"/>
                            <Button Content="New" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="NewProfile_Click"/>
                            <Button Content="Copy" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="CopyProfile_Click"/>
                            <Button Content="Rename" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="RenameProfile_Click"/>
                            <Button Content="Delete" Margin="0,0,5,0" Padding="10,5" FontSize="12" Style="{StaticResource DangerButton}" Click="DeleteProfile_Click"/>
                            <Button Content="Import" Padding="10,5" FontSize="12" Click="ImportProfile_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileNote" Foreground="{StaticResource BrushAccentHover}" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Right"
                                   Visibility="Collapsed" Text="Save switches to this profile"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardPositions" Header="POSITIONS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Where each thumbnail is remembered."/><RadioButton x:Name="ModeCharacterRadio" GroupName="PositionMode"><TextBlock TextWrapping="Wrap" Text="Save by character: a character's thumbnail stays where you put it, whichever client they log in on"/></RadioButton><RadioButton x:Name="ModeClientRadio" GroupName="PositionMode"><TextBlock TextWrapping="Wrap" Text="Save by client: the 1st client to open always uses the 1st position, the 2nd the 2nd, and so on (login screens included)"/></RadioButton><CheckBox x:Name="InheritBox" Margin="0,6,0,14"><TextBlock TextWrapping="Wrap" Text="A new character takes the position and size of the login screen it replaces"/></CheckBox><WrapPanel Margin="0,0,0,6"><Button x:Name="RecoverBtn" Content="Recover off-screen thumbnails" Padding="12,6" Margin="0,0,8,8" Click="Recover_Click" /><Button x:Name="ResetPosBtn" Content="Reset all positions" Padding="12,6" Margin="0,0,8,8" Click="ResetPositions_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Recover moves any thumbnail that ended up off the screen back onto your main monitor. It also happens by itself when your monitors change."/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardSize" Header="SIZE" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Keep every thumbnail the same size, or let each one have its own."/><CheckBox x:Name="SameSizeBox"><TextBlock TextWrapping="Wrap" Text="Keep all thumbnails the same size (resize one and they all follow)"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBox Style="{StaticResource FieldLabel}" Text="Default / Shared Width" /><TextBox x:Name="WidthBox" /><TextBox Style="{StaticResource Desc}" Text="120 to 1200 pixels"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Default / Shared Height" /><TextBox x:Name="HeightBox" /><TextBox Style="{StaticResource Desc}" Text="0 = automatic 16:9, otherwise 45 to 1200"/></StackPanel></Grid></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardInteraction" Header="INTERACTION" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Mouse behaviour for switching, moving and resizing thumbnails."/><CheckBox x:Name="ClickableBox"><TextBlock TextWrapping="Wrap" Text="Thumbnails are clickable (untick to switch with the hotkeys only)"/></CheckBox><CheckBox x:Name="LoginClickableBox"><TextBlock TextWrapping="Wrap" Text="Thumbnails of clients that aren't logged in yet are clickable too"/></CheckBox><CheckBox x:Name="LockBox"><TextBlock TextWrapping="Wrap" Text="Lock thumbnail positions and sizes (no moving or resizing)"/></CheckBox><CheckBox x:Name="SnapBox"><TextBlock TextWrapping="Wrap" Text="Snap thumbnails together when dragged close"/></CheckBox><CheckBox x:Name="OnTopBox"><TextBlock TextWrapping="Wrap" Text="Keep thumbnails always on top of other windows"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Snap Distance (px)" /><TextBox x:Name="SnapDistBox" /><TextBox Style="{StaticResource Desc}" Text="Hold Shift and drag with the left mouse button to move a thumbnail. Drag the small triangle in its bottom-right corner to resize it. Thumbnails are overlays: clicking one never takes focus from the game."/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardStartup" Header="STARTUP" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Launch EVE-IronWorks-Preview automatically when you log into Windows. This is saved with the app, not with a profile."/><CheckBox x:Name="RunOnStartupBox"><TextBlock TextWrapping="Wrap" Text="Run on Startup"/></CheckBox></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardTray" Header="TRAY ICON" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Windows 11 tucks new tray icons behind the ^ (show hidden icons) arrow. This keeps the icon on the taskbar itself. It is Windows' own per-icon switch, so you can also change it under Settings &gt; Personalisation &gt; Taskbar &gt; Other system tray icons. Saved with the app, not with a profile."/><CheckBox x:Name="PinTrayBox"><TextBlock TextWrapping="Wrap" Text="Keep the tray icon on the taskbar, not in the hidden icons"/></CheckBox><WrapPanel Margin="0,0,0,6"><Button x:Name="OpenTaskbarBtn" Content="Open Windows taskbar settings" Padding="12,6" Margin="0,0,8,8" Click="OpenTaskbarSettings_Click" /></WrapPanel></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardScanning" Header="SCANNING" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="How often the app looks for new or closed EVE clients. Focus changes are picked up instantly either way."/><TextBox Style="{StaticResource FieldLabel}" Text="Client Scan Interval (ms)" /><TextBox x:Name="RefreshBox" /><TextBox Style="{StaticResource Desc}" Text="500 to 10000"/></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer><ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardOpacity" Header="OPACITY" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="How solid the live thumbnails are. Lower is more see-through."/><TextBox x:Name="OpacityLabel" Style="{StaticResource FieldLabel}" Text="Thumbnail Opacity: 60%"/><Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="60" ValueChanged="OpacitySlider_ValueChanged"/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardLabel" Header="TEXT LABEL" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The character name drawn on each thumbnail."/><CheckBox x:Name="LabelsBox"><TextBlock TextWrapping="Wrap" Text="Show character names on thumbnails"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Font" /><ComboBox x:Name="FontBox" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBox Style="{StaticResource FieldLabel}" Text="Font Size" /><TextBox x:Name="FontSizeBox" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Text Position" /><ComboBox x:Name="LabelPositionBox" /></StackPanel></Grid><CheckBox x:Name="BoldBox"><TextBlock TextWrapping="Wrap" Text="Bold"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Default Text Colour" /><local:ColourField x:Name="LabelColourBox" FallbackHex="#FFFFFF"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBox Style="{StaticResource FieldLabel}" Text="Horizontal Offset (px)" /><TextBox x:Name="OffsetXBox" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Vertical Offset (px)" /><TextBox x:Name="OffsetYBox" /></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Offsets run from -300 to 300."/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardLabelBg" Header="TEXT BACKGROUND" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The box behind the text label."/><TextBox Style="{StaticResource FieldLabel}" Text="Background Colour" /><local:ColourField x:Name="LabelBgBox" FallbackHex="#0C0C0E"/><TextBox x:Name="BgOpacityLabel" Style="{StaticResource FieldLabel}" Text="Background Opacity: 67%"/><Slider x:Name="LabelBgOpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="67" ValueChanged="BgOpacitySlider_ValueChanged"/><TextBox Style="{StaticResource Desc}" Text="0% means no background at all."/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardActiveBorder" Header="ACTIVE BORDER" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="A border on the thumbnail of the client you're in."/><CheckBox x:Name="HighlightBox"><TextBlock TextWrapping="Wrap" Text="Show a border on the active client's thumbnail"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Colour" /><local:ColourField x:Name="ColourBox" FallbackHex="#F97316"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBox Style="{StaticResource FieldLabel}" Text="Width (px)" /><TextBox x:Name="ActiveWidthBox" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Style" /><ComboBox x:Name="ActiveStyleBox" /></StackPanel></Grid></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardInactiveBorder" Header="INACTIVE BORDER" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="A border on the thumbnails of the other clients."/><CheckBox x:Name="InactiveBox"><TextBlock TextWrapping="Wrap" Text="Show a border on inactive clients' thumbnails"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Colour" /><local:ColourField x:Name="InactiveColourBox" FallbackHex="#6F6F7D"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBox Style="{StaticResource FieldLabel}" Text="Width (px)" /><TextBox x:Name="InactiveWidthBox" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Style" /><ComboBox x:Name="InactiveStyleBox" /></StackPanel></Grid></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer><ScrollViewer x:Name="PageThumbs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardRoster" Header="CHARACTERS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The characters that get a thumbnail, kept in groups. Pick the group to use, type a character name on each line and press + to add another line. Tick a line to show its thumbnail, untick it to hide it."/><TextBox Style="{StaticResource FieldLabel}" Text="Group In Use" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ThumbGroupBox" Margin="0" SelectionChanged="ThumbGroup_SelectionChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="NewThumbGroupBtn" Content="New" Padding="12,6" Margin="0,0,5,0" Click="NewThumbGroup_Click"/><Button x:Name="RenameThumbGroupBtn" Content="Rename" Padding="12,6" Margin="0,0,5,0" Click="RenameThumbGroup_Click"/><Button x:Name="DeleteThumbGroupBtn" Content="Delete" Padding="12,6" Style="{StaticResource DangerButton}" Click="DeleteThumbGroup_Click"/></StackPanel></Grid><StackPanel x:Name="ClientChecks"/><WrapPanel Margin="0,0,0,6"><Button x:Name="AddThumbBtn" Content="+  Add character" Padding="12,6" Margin="0,0,8,8" Click="AddThumb_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="SelectAllBtn" Content="Select all" Padding="12,6" Margin="0,0,8,8" Click="SelectAll_Click" /><Button x:Name="SelectNoneBtn" Content="Select none" Padding="12,6" Margin="0,0,8,8" Click="SelectNone_Click" /></WrapPanel><CheckBox x:Name="LoginScreensBox"><TextBlock TextWrapping="Wrap" Text="Login screens (clients that aren't logged in yet)"/></CheckBox><CheckBox x:Name="ShowUnlistedBox"><TextBlock TextWrapping="Wrap" Text="Also show thumbnails for logged-in characters that aren't in this group"/></CheckBox></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardScan" Header="FIND RUNNING CLIENTS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Scans every running EVE client for its character name and lists them here. Tick the ones you want and add them to the group above. Clients still on the login screen have no name yet."/><WrapPanel Margin="0,0,0,6"><Button x:Name="ScanBtn" Content="Scan running clients" Padding="12,6" Margin="0,0,8,8" Click="Scan_Click" /><Button x:Name="ScanAllBtn" Content="Select all" Padding="12,6" Margin="0,0,8,8" Click="ScanSelectAll_Click" /><Button x:Name="AddScannedBtn" Content="Add selected" Padding="12,6" Margin="0,0,8,8" Click="AddScanned_Click" Style="{StaticResource PrimaryButton}" /></WrapPanel><TextBox x:Name="ScanNote" Style="{StaticResource Desc}" Text="Press Scan to look for clients."/><Border x:Name="ScanBox" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="3" Background="{StaticResource BrushInput}" Padding="12,10,12,2" MinHeight="46" Margin="0,0,0,12"><ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ScanHost"/></ScrollViewer></Border></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardHiding" Header="HIDING" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Rules that hide thumbnails automatically."/><CheckBox x:Name="HideActiveBox"><TextBlock TextWrapping="Wrap" Text="Hide the thumbnail of the client I'm currently in"/></CheckBox><CheckBox x:Name="HideUnfocusedBox"><TextBlock TextWrapping="Wrap" Text="Hide all thumbnails while EVE isn't the window in front"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Delay Before Hiding (ms)" /><TextBox x:Name="HideDelayBox" /><TextBox Style="{StaticResource Desc}" Text="0 to 5000. A short delay stops thumbnails flickering when you click between windows."/></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer><ScrollViewer x:Name="PageCharacters" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardCharacter" Header="CHARACTER" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Pick a character, then change how its thumbnail looks. Leave a field empty or 0 to use the default."/><TextBox x:Name="NoCharText" Style="{StaticResource Desc}" Visibility="Collapsed" Text="No characters known yet. Log in an EVE client, then reopen settings."/><ComboBox x:Name="CharBox" SelectionChanged="CharBox_SelectionChanged"/><TextBox Style="{StaticResource FieldLabel}" Text="Preview" /><Border Background="{StaticResource BrushInput}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left"><TextBlock x:Name="LabelPreview" FontWeight="SemiBold" FontSize="14" Text="Character name"/></Border><TextBox Style="{StaticResource FieldLabel}" Text="Label Text" /><TextBox x:Name="LabelBox" TextChanged="LabelBox_TextChanged"/><TextBox Style="{StaticResource Desc}" Text="Empty = the character name."/><TextBox Style="{StaticResource FieldLabel}" Text="Label Colour" /><local:ColourField x:Name="CharColourBox" FallbackHex="#FFFFFF" AllowEmpty="True"/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardCharSize" Header="CHARACTER SIZE" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Ignored while all thumbnails are kept the same size (Settings &gt; General)."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBox Style="{StaticResource FieldLabel}" Text="Width" /><TextBox x:Name="CharWidthBox" /><TextBox Style="{StaticResource Desc}" Text="0 = default, otherwise 80 to 1600"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Height" /><TextBox x:Name="CharHeightBox" /><TextBox Style="{StaticResource Desc}" Text="0 = automatic 16:9, otherwise 45 to 1200"/></StackPanel></Grid></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardCharHotkey" Header="CHARACTER HOTKEY" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="A key, mouse button or combination that jumps straight to this character's client."/><TextBox Style="{StaticResource FieldLabel}" Text="Jump-To Hotkey" /><local:HotkeyField x:Name="CharHotkeyBox"/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardCharActions" Header="WHEN I SWITCH" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="What happens to this character's client window when you switch to it, and when you switch away from it."/><TextBox Style="{StaticResource FieldLabel}" Text="When I Switch To This Client" /><ComboBox x:Name="CharActionBox" /><CheckBox x:Name="CharMinLeaveBox"><TextBlock TextWrapping="Wrap" Text="Minimise this client when I switch away from it"/></CheckBox></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer><ScrollViewer x:Name="PageHotkeys" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardCycling" Header="CYCLING" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Click a box, then press the key, mouse button or combination you want. Use the ✕ to clear it. Next and previous go in the client order (see CLIENT ORDER below), and skip any client that is not responding."/><TextBox Style="{StaticResource FieldLabel}" Text="Next Client" /><local:HotkeyField x:Name="ForwardBox"/><TextBox Style="{StaticResource FieldLabel}" Text="Previous Client" /><local:HotkeyField x:Name="BackBox"/><CheckBox x:Name="CycleLoginBox"><TextBlock TextWrapping="Wrap" Text="Include clients that are still on the login screen"/></CheckBox></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardClientOrder" Header="CLIENT ORDER" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The order the Next / Previous hotkeys go in. The numbered positions and the client hotkeys count in the same order."/><RadioButton x:Name="OrderAutoRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBlock TextWrapping="Wrap" Text="Automatic: the order the clients were opened"/></RadioButton><RadioButton x:Name="OrderSavedRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBlock TextWrapping="Wrap" Text="Saved: the order is remembered, so closing and reopening a client puts it back in the same place. New characters are added to the end by themselves"/></RadioButton><RadioButton x:Name="OrderManualRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBlock TextWrapping="Wrap" Text="Manual: you set the order below. New characters show up unticked and only count once you tick them"/></RadioButton><StackPanel x:Name="OrderSavedPanel" Margin="0,12,0,0" Visibility="Collapsed"><TextBox Style="{StaticResource FieldLabel}" Text="Saved Order" /><TextBox x:Name="SavedOrderText" Style="{StaticResource Desc}" Text=""/><TextBox x:Name="OrderResetNote" Style="{StaticResource Desc}" Foreground="{StaticResource BrushAccentHover}" Visibility="Collapsed" Text=""/><WrapPanel Margin="0,0,0,6"><Button x:Name="ResetOrderBtn" Content="Reset order" Padding="12,6" Margin="0,0,8,8" Click="ResetOrder_Click" /><Button x:Name="CancelResetBtn" Content="Cancel reset" Padding="12,6" Margin="0,0,8,8" Click="CancelReset_Click" Visibility="Collapsed" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Reset order clears the saved list the next time all your EVE clients are closed (or none are open). It then builds up again in the order the clients are opened, like the first time. Until then nothing changes."/></StackPanel><StackPanel x:Name="OrderListPanel" Margin="0,12,0,0"><TextBox Style="{StaticResource Desc}" Text="Tick a character to put it in the order, then use the arrows to move it. Characters that aren't ticked come after the ticked ones, in the order they were opened. A client still on the login screen takes the first free place in the list, so it is already in position when the character logs in."/><WrapPanel Margin="0,0,0,6"><Button x:Name="OrderTickAllBtn" Content="Tick all" Padding="12,6" Margin="0,0,8,8" Click="OrderTickAll_Click" /><Button x:Name="OrderUntickAllBtn" Content="Untick all" Padding="12,6" Margin="0,0,8,8" Click="OrderUntickAll_Click" /></WrapPanel><TextBox x:Name="NoOrderText" Style="{StaticResource Desc}" Visibility="Collapsed" Text="No characters known yet. Log in an EVE client, then reopen settings."/><StackPanel x:Name="OrderChecks"/></StackPanel></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardHotkeyOptions" Header="HOTKEY OPTIONS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Hotkeys can be any key or mouse button, with or without modifiers. These options say where they work and what happens to the key."/><CheckBox x:Name="HotkeysOnlyEveBox"><TextBlock TextWrapping="Wrap" Text="Hotkeys only work while an EVE client is the window in front"/></CheckBox><CheckBox x:Name="PassThroughBox"><TextBlock TextWrapping="Wrap" Text="Let the key or button reach the program as well (do not swallow it)"/></CheckBox><TextBox Style="{StaticResource Desc}" Text="A single key with no modifier (like T) is taken over everywhere unless you tick the first option, and it stops typing that letter. Right-side modifiers are saved as RCtrl, RAlt, RShift and RWin; the left-side ones match either side."/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardSlotKeys" Header="CLIENT HOTKEYS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="A hotkey for the 1st client in the client order, the 2nd, and so on (clients still on the login screen count). Press + to add a line for another client. Keep several sets in groups and pick the group to use."/><TextBox Style="{StaticResource FieldLabel}" Text="Group In Use" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SlotGroupBox" Margin="0" SelectionChanged="SlotGroup_SelectionChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="NewSlotGroupBtn" Content="New" Padding="12,6" Margin="0,0,5,0" Click="NewSlotGroup_Click"/><Button x:Name="RenameSlotGroupBtn" Content="Rename" Padding="12,6" Margin="0,0,5,0" Click="RenameSlotGroup_Click"/><Button x:Name="DeleteSlotGroupBtn" Content="Delete" Padding="12,6" Style="{StaticResource DangerButton}" Click="DeleteSlotGroup_Click"/></StackPanel></Grid><StackPanel x:Name="SlotHotkeyHost"/><WrapPanel Margin="0,0,0,6"><Button x:Name="AddSlotBtn" Content="+  Add client" Padding="12,6" Margin="0,0,8,8" Click="AddSlot_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="RemoveSlotBtn" Content="-  Remove last" Padding="12,6" Margin="0,0,8,8" Click="RemoveSlot_Click"/></WrapPanel></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardSkipped" Header="SKIPPED CLIENTS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Tick a client to make the next / previous hotkeys skip it. You can still switch to it by clicking its thumbnail or with its own hotkey."/><TextBox Style="{StaticResource Desc}" Foreground="{StaticResource BrushAccentHover}" Text="Note: the thumbnail of a skipped client is marked with a red X."/><TextBox x:Name="NoSkipText" Style="{StaticResource Desc}" Visibility="Collapsed" Text="No characters known yet. Log in an EVE client, then reopen settings."/><StackPanel x:Name="SkipChecks"/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardProfileKeys" Header="PROFILE HOTKEYS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Switch profiles from the keyboard. The first box belongs to the profile shown at the top."/><TextBox Style="{StaticResource FieldLabel}" Text="Switch To This Profile" /><local:HotkeyField x:Name="ProfileHotkeyBox"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBox Style="{StaticResource FieldLabel}" Text="Next Profile" /><local:HotkeyField x:Name="NextProfileBox"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Previous Profile" /><local:HotkeyField x:Name="PrevProfileBox"/></StackPanel></Grid></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer><ScrollViewer x:Name="PageClients" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardAutoMin" Header="AUTO-MINIMIZE" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Minimizes the other EVE clients so they stop using the graphics card and processor."/><CheckBox x:Name="AutoMinBox"><TextBlock TextWrapping="Wrap" Text="Enable Auto-Minimize"/></CheckBox><CheckBox x:Name="KeepLastBox"><TextBlock TextWrapping="Wrap" Text="When EVE isn't in front, keep the client I used last visible"/></CheckBox><CheckBox x:Name="MinOnStartBox"><TextBlock TextWrapping="Wrap" Text="Also minimize clients that haven't been in front yet (loading, or on the login screen)"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Delay (s)" /><TextBox x:Name="AutoMinDelayBox" /><TextBox Style="{StaticResource Desc}" Text="0 to 600, where 0 is straight away. Windows animates a minimized client back up when you switch to it, so that switch is a little slower."/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardNeverMin" Header="NEVER MINIMIZE" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Tick the clients that auto-minimize should leave alone."/><TextBox x:Name="NoMinText" Style="{StaticResource Desc}" Visibility="Collapsed" Text="No characters known yet. Log in an EVE client, then reopen settings."/><StackPanel x:Name="MinChecks"/></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer><ScrollViewer x:Name="PageNotifications" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardNotifyMain" Header="NOTIFICATIONS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Alerts for the events switched on under Log Monitoring. They only fire for logged-in clients, and only while log monitoring is on."/><CheckBox x:Name="NotifyEnabledBox"><TextBlock TextWrapping="Wrap" Text="Enable Notifications"/></CheckBox><CheckBox x:Name="NotifySkipActiveBox"><TextBlock TextWrapping="Wrap" Text="Don't alert me about the client I'm currently in"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Cooldown Between Alerts (s)" /><TextBox x:Name="NotifyCooldownBox" /><TextBox Style="{StaticResource Desc}" Text="The same alert for the same character is not repeated within this time."/><WrapPanel Margin="0,0,0,6"><Button x:Name="TestNotifyBtn" Content="Send a test alert" Padding="12,6" Margin="0,0,8,8" Click="TestNotify_Click" /></WrapPanel></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardNotifyHow" Header="HOW YOU ARE ALERTED" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Tick as many as you like."/><CheckBox x:Name="NotifyFlashBox"><TextBlock TextWrapping="Wrap" Text="Flash the client's thumbnail border"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Flash Colour" /><local:ColourField x:Name="NotifyColourBox" FallbackHex="#F87171"/><TextBox Style="{StaticResource FieldLabel}" Text="Flash For (s)" /><TextBox x:Name="NotifySecondsBox" /><CheckBox x:Name="NotifyToastBox"><TextBlock TextWrapping="Wrap" Text="Show a Windows notification"/></CheckBox><CheckBox x:Name="NotifySoundBox"><TextBlock TextWrapping="Wrap" Text="Play a sound"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBox Style="{StaticResource FieldLabel}" Text="Sound" /><ComboBox x:Name="NotifySoundCombo" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Custom Sound File (.wav)" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NotifySoundFileBox" Margin="0"/><Button x:Name="BrowseSoundBtn" Grid.Column="1" Content="..." Padding="14,6" Margin="6,0,0,0" Click="BrowseSound_Click"/></Grid></StackPanel></Grid><CheckBox x:Name="NotifySpeakBox"><TextBlock TextWrapping="Wrap" Text="Speak the alert out loud (Windows text-to-speech)"/></CheckBox></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer><ScrollViewer x:Name="PageLogs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardLogMain" Header="LOG MONITORING" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Reads the log files the EVE client writes for you (Documents\EVE\logs) to spot events. It only reads them: it never sends anything to the game."/><CheckBox x:Name="LogEnabledBox"><TextBlock TextWrapping="Wrap" Text="Enable Log Monitoring"/></CheckBox><TextBox x:Name="LogStatusText" Style="{StaticResource Desc}" Text=""/><TextBox Style="{StaticResource FieldLabel}" Text="Check For New Lines Every (ms)" /><TextBox x:Name="LogPollBox" /><TextBox Style="{StaticResource Desc}" Text="250 to 10000"/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardLogFolders" Header="LOG FOLDERS" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Leave empty to use the standard folders under Documents\EVE\logs."/><TextBox Style="{StaticResource FieldLabel}" Text="Game Logs Folder" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GameFolderBox" Margin="0"/><Button Grid.Column="1" Content="Browse" Padding="14,6" Margin="6,0,0,0" Click="BrowseGame_Click"/></Grid><TextBox Style="{StaticResource FieldLabel}" Text="Chat Logs Folder" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatFolderBox" Margin="0"/><Button Grid.Column="1" Content="Browse" Padding="14,6" Margin="6,0,0,0" Click="BrowseChat_Click"/></Grid></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardLogEvents" Header="EVENTS TO WATCH" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="What counts as an event."/><CheckBox x:Name="LogAttackBox"><TextBlock TextWrapping="Wrap" Text="Under attack: incoming damage in the combat log"/></CheckBox><CheckBox x:Name="LogMiningBox"><TextBlock TextWrapping="Wrap" Text="Mining has gone quiet"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Quiet For (s)" /><TextBox x:Name="LogMiningSecondsBox" /><TextBox Style="{StaticResource Desc}" Text="Raises an alert when no mining lines have been logged for this long (10 or more)."/><TextBox Style="{StaticResource FieldLabel}" Text="Keywords" /><TextBox x:Name="LogKeywordsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><TextBox Style="{StaticResource Desc}" Text="One phrase per line. A game-log line containing one of them raises an alert (for example: warp scramble)."/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardLogSystem" Header="SYSTEM NAME" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Reads the Local chat log to learn which solar system each character is in."/><CheckBox x:Name="LogSystemBox"><TextBlock TextWrapping="Wrap" Text="Show the solar system next to the name on each thumbnail"/></CheckBox></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer><ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="22,20,22,6"><HeaderedContentControl x:Name="CardAbout" Header="ABOUT" Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Image Source="/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="EVE-IronWorks-Preview" FontWeight="Bold" FontSize="17" Foreground="White"/><TextBox x:Name="VersionText" Style="{StaticResource SelectableText}" Text="v0.0.0" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/><TextBlock FontSize="12" Margin="0,3,0,0"><Hyperlink Style="{StaticResource CreditLink}" NavigateUri="https://autz-ironworks.vercel.app/#/home" RequestNavigate="Website_RequestNavigate">by AUTZ IronWorks · From planets to profit</Hyperlink></TextBlock></StackPanel></StackPanel><TextBox Style="{StaticResource Desc}" Text="Also known as EVE-IW-Preview (the exe, the GitHub repository and posts). Live previews of your running EVE Online clients and instant client switching. It only shows a picture of each client and brings the window to the front: it never sends keys or mouse clicks to EVE."/></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardWhatsNew" Header="WHAT'S NEW" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The pop-up with the version and the latest changes."/><TextBox Style="{StaticResource FieldLabel}" Text="Show The Pop-Up" /><ComboBox x:Name="WhatsNewCombo" /><WrapPanel Margin="0,0,0,6"><Button x:Name="ViewChangelogBtn" Content="View changelog" Padding="12,6" Margin="0,0,8,8" Click="ViewChangelog_Click" /></WrapPanel></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardFiles" Header="FILES" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Profiles, the active-profile file and the diagnostics log live here."/><TextBox x:Name="FolderText" Style="{StaticResource SelectableText}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource BrushText}"/><WrapPanel Margin="0,0,0,6"><Button x:Name="OpenFolderBtn" Content="Open folder" Padding="12,6" Margin="0,0,8,8" Click="OpenFolder_Click" /><Button x:Name="OpenLogBtn" Content="Open log" Padding="12,6" Margin="0,0,8,8" Click="OpenLog_Click" /></WrapPanel></StackPanel></HeaderedContentControl><HeaderedContentControl x:Name="CardDiagnostics" Header="DIAGNOSTICS (ADMIN LOG)" Style="{StaticResource Card}"><StackPanel><TextBox Style="{StaticResource Desc}" Text="Detailed logging writes every step the app takes to debug.log, with millisecond timestamps: each hotkey press, each focus attempt and which method worked, every minimise, restore and maximise it sends to a client, thumbnails shown, hidden, created and closed, and every focus change Windows reports. Turn it on, reproduce the problem, then open the log. It is written in the background, so it doesn't slow switching down. This setting is app-wide, not per profile."/><CheckBox x:Name="DebugLogBox"><TextBlock TextWrapping="Wrap" Text="Detailed logging"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Log File" /><RadioButton x:Name="DebugContinuousRadio" GroupName="DebugMode"><TextBlock TextWrapping="Wrap" Text="One continuous log (debug.log) that carries on each time logging is turned on"/></RadioButton><RadioButton x:Name="DebugSessionRadio" GroupName="DebugMode"><TextBlock TextWrapping="Wrap" Text="A new log every time logging is turned on (debug-DATE_TIME.log), so each test is its own file"/></RadioButton><WrapPanel Margin="0,0,0,6"><Button x:Name="OpenDebugLogBtn" Content="Open debug log" Padding="12,6" Margin="0,0,8,8" Click="OpenDebugLog_Click" /><Button x:Name="ClearDebugLogBtn" Content="Clear debug log" Padding="12,6" Margin="0,0,8,8" Click="ClearDebugLog_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Privacy: the logs never contain character names, profile names, the titles of other windows, your Windows user name, your PC name or folder paths. A character or profile name shows as a short code (for example Pilot-3FA9C1): the same name always gives the same code on this PC, but the name can't be worked out from it, so a log can be sent to someone safely. Also in the tray menu: Detailed Logging and Open Debug Log. Open debug log opens the newest one. The continuous log rolls over to debug.old.log at about 4 MB; the newest 20 separate logs are kept. Changing the setting while logging is on carries on in the other kind of file straight away."/></StackPanel></HeaderedContentControl></StackPanel></ScrollViewer>
            </Grid>

            <!-- footer: search, status, buttons -->
            <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Padding="22,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="230">
                        <TextBox x:Name="SearchBox" Margin="0" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Search settings ..." Foreground="{StaticResource BrushDim}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                    <TextBox x:Name="StatusText" Style="{StaticResource SelectableText}" Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ResetBtn" Content="Reset" Width="82" Margin="0,0,16,0" Click="Reset_Click" ToolTip="Put this profile's settings back to their defaults"/>
                        <Button x:Name="ApplyBtn" Content="Apply" Width="82" Margin="0,0,8,0" Click="Apply_Click" ToolTip="Use these settings now, without saving them"/>
                        <Button x:Name="SaveBtn" Content="Save" Width="82" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" ToolTip="Save these settings to the config file"/>
                        <Button x:Name="CloseBtn" Content="Close" Width="82" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



