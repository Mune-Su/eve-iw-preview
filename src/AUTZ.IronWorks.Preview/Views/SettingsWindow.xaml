<Window x:Class="AUTZ.IronWorks.Preview.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AUTZ.IronWorks.Preview.Views"
        Title="EVE-IronWorks-Preview Configuration"
        Icon="/Assets/app.ico"
        Width="1100" Height="820" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}" Foreground="{StaticResource BrushText}"
        FontFamily="Inter, Segoe UI" FontSize="13"
        ShowInTaskbar="True">
    <!-- Same layout as the website: a sidebar with the brand and the menu on the left, the page on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== sidebar ===== -->
        <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,20,14,18">
                    <Image Source="/Assets/logo.png" Width="40" Height="40" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,8"/>
                    <TextBlock Text="EVE-IronWorks" FontSize="19" FontWeight="Black" Foreground="{StaticResource BrushText}"/>
                    <TextBlock Text="PREVIEW" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource BrushAccent}" Margin="0,1,0,0"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"><Hyperlink Style="{StaticResource CreditLink}" NavigateUri="https://autz-ironworks.vercel.app/#/home" RequestNavigate="Website_RequestNavigate">by AUTZ IronWorks · From planets to profit</Hyperlink></TextBlock>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" Margin="12,0,12,10"/>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Margin="14,0,14,0" Padding="4,12,4,14">
                    <TextBox x:Name="SidebarVersion" Style="{StaticResource SelectableText}" Text="v0.0.0" FontSize="11" Foreground="{StaticResource BrushDim}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== right side: heading + profile bar, page, footer ===== -->
        <Grid Grid.Column="1" Background="{StaticResource BrushBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- viewhead: small caps label + page title, and the profile controls (like the website's toollinks) -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Padding="22,16,22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CONFIGURATION" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock x:Name="PageTitleText" Text="General" FontSize="26" FontWeight="Bold" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="PROFILE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileBox" Width="170" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="ProfileBox_SelectionChanged"/>
                            <Button Content="New" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="NewProfile_Click"/>
                            <Button Content="Copy" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="CopyProfile_Click"/>
                            <Button Content="Rename" Margin="0,0,5,0" Padding="10,5" FontSize="12" Click="RenameProfile_Click"/>
                            <Button Content="Delete" Margin="0,0,5,0" Padding="10,5" FontSize="12" Style="{StaticResource DangerButton}" Click="DeleteProfile_Click"/>
                            <Button Content="Import" Padding="10,5" FontSize="12" Click="ImportProfile_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileNote" Foreground="{StaticResource BrushAccentHover}" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Right"
                                   Visibility="Collapsed" Text="Save switches to this profile"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardStartup" Header="STARTUP AND TRAY ICON" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="For the whole app, not one profile."/><CheckBox x:Name="RunOnStartupBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Run on Startup"/></CheckBox><CheckBox x:Name="PinTrayBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Keep the tray icon on the taskbar, not in the hidden icons"/></CheckBox><CheckBox x:Name="AlwaysAdminBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Always start as administrator"/></CheckBox><TextBox x:Name="AlwaysAdminNote" Style="{StaticResource Desc}" Text=""/><WrapPanel Margin="0,0,0,2"><Button x:Name="OpenTaskbarBtn" Content="Open Windows taskbar settings" Padding="10,4" Margin="0,0,6,6" Click="OpenTaskbarSettings_Click"/></WrapPanel></StackPanel>
</Expander>

<Expander x:Name="CardComponents" Header="FEATURES" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Turn the switcher or memory cleaner on or off. Also in the tray menu."/><WrapPanel Margin="0,0,0,2"><Button x:Name="SwitcherToggleBtn" Content="Disable Switcher" Padding="10,4" Margin="0,0,6,6" Click="SwitcherToggle_Click"/><Button x:Name="MemoryCleanerToggleBtn" Content="Disable Memory Cleaner" Padding="10,4" Margin="0,0,6,6" Click="MemoryCleanerToggle_Click"/></WrapPanel><TextBox Style="{StaticResource FieldLabel}" Text="Switcher Off For These Clients"/><TextBox Style="{StaticResource Desc}" Text="Ticked clients get no thumbnail, cycling or hotkeys. Saved straight away."/><StackPanel x:Name="SwitcherClientRows" Margin="0,0,0,4"/></StackPanel>
</Expander>
<Expander x:Name="CardWhatsNew" Header="WHAT'S NEW" Style="{StaticResource Card}" IsExpanded="False"><StackPanel><TextBox Style="{StaticResource Desc}" Text="The pop-up that shows what changed."/><TextBox Style="{StaticResource FieldLabel}" Text="Show The Pop-Up" /><ComboBox x:Name="WhatsNewCombo" /><WrapPanel Margin="0,0,0,2"><Button x:Name="ViewChangelogBtn" Content="View changelog" Padding="10,4" Margin="0,0,6,6" Click="ViewChangelog_Click" /></WrapPanel></StackPanel></Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageClients" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardClients" Header="CLIENTS" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Finding clients, and minimising the ones you aren't using."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Client Scan Interval (ms)"/><TextBox x:Name="RefreshBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Auto-Minimize Delay (s)"/><TextBox x:Name="AutoMinDelayBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Scan: 500–10000 ms. Delay: 0–600 s (0 = straight away)."/><CheckBox x:Name="AutoMinBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Auto-minimise the other EVE clients"/></CheckBox><CheckBox x:Name="KeepLastBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="When EVE isn't in front, keep the client I used last visible"/></CheckBox><CheckBox x:Name="MinOnStartBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Also minimise clients not used yet (loading or login screen)"/></CheckBox><TextBox Style="{StaticResource Desc}" Text="Switching to a minimised client is a little slower."/><TextBox Style="{StaticResource FieldLabel}" Text="Never Minimize These Clients"/><TextBox x:Name="NoMinText" Style="{StaticResource Desc}" Text="No characters yet. Log in a client, then reopen this window." Visibility="Collapsed"/><StackPanel x:Name="MinChecks"/></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageThumbs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardSize" Header="SIZE AND OPACITY" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><CheckBox x:Name="SameSizeBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Keep all thumbnails the same size"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Default / Shared Width"/><TextBox x:Name="WidthBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Default / Shared Height"/><TextBox x:Name="HeightBox"/></StackPanel><StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBox x:Name="OpacityLabel" Style="{StaticResource FieldLabel}" Text="Thumbnail Opacity: 60%"/><Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="60" ValueChanged="OpacitySlider_ValueChanged"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Width: 120–1200. Height: 0 = auto 16:9, or 45–1200."/></StackPanel>
</Expander>
<Expander x:Name="CardLabel" Header="TEXT LABEL" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="The name on each thumbnail."/><StackPanel Orientation="Horizontal"><CheckBox x:Name="LabelsBox" Margin="0,0,24,6"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Show character names on thumbnails"/></CheckBox><CheckBox x:Name="BoldBox" Margin="0,0,0,6"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Bold"/></CheckBox></StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Font"/><ComboBox x:Name="FontBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Font Size"/><TextBox x:Name="FontSizeBox"/></StackPanel><StackPanel Grid.Column="2" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Position"/><ComboBox x:Name="LabelPositionBox"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Text Colour"/><local:ColourField x:Name="LabelColourBox" FallbackHex="#FFFFFF"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Background Colour"/><local:ColourField x:Name="LabelBgBox" FallbackHex="#0C0C0E"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox x:Name="LabelOpacityLabel" Style="{StaticResource FieldLabel}" Text="Text Opacity: 60%"/><Slider x:Name="LabelOpacitySlider" Minimum="10" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="60" ValueChanged="LabelOpacitySlider_ValueChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox x:Name="BgOpacityLabel" Style="{StaticResource FieldLabel}" Text="Background Opacity: 60%"/><Slider x:Name="LabelBgOpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="60" ValueChanged="BgOpacitySlider_ValueChanged"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Horizontal Offset (px)"/><TextBox x:Name="OffsetXBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Vertical Offset (px)"/><TextBox x:Name="OffsetYBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Offset: -300 to 300. Background 0% = no box."/></StackPanel>
</Expander>
<Expander x:Name="CardActiveBorder" Header="BORDERS" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Borders for the client you're in, the others, and alerts."/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Client You're In"/><CheckBox x:Name="HighlightBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Show a border on the active client's thumbnail"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Colour"/><local:ColourField x:Name="ColourBox" FallbackHex="#F97316"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Width (px)"/><TextBox x:Name="ActiveWidthBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Style"/><ComboBox x:Name="ActiveStyleBox"/></StackPanel></Grid></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Other Clients"/><CheckBox x:Name="InactiveBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Show a border on inactive clients' thumbnails"/></CheckBox><TextBox Style="{StaticResource FieldLabel}" Text="Colour"/><local:ColourField x:Name="InactiveColourBox" FallbackHex="#6F6F7D"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Width (px)"/><TextBox x:Name="InactiveWidthBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Style"/><ComboBox x:Name="InactiveStyleBox"/></StackPanel></Grid></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Alert Flash Colour"/><local:ColourField x:Name="NotifyColourBox" FallbackHex="#F87171"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource Desc}" Text="Border colour when an alert fires." Margin="0,24,0,0"/></StackPanel></Grid></StackPanel>
</Expander>
<Expander x:Name="CardCharacter" Header="PER-CHARACTER OVERRIDES" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Give one character its own look. Empty or 0 = use the defaults."/><TextBox x:Name="NoCharText" Style="{StaticResource Desc}" Text="No characters yet. Log in a client, then reopen this window." Visibility="Collapsed"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Character"/><ComboBox x:Name="CharBox" SelectionChanged="CharBox_SelectionChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Preview"/><Border Background="{StaticResource BrushInput}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,0,8" HorizontalAlignment="Left"><TextBlock x:Name="LabelPreview" FontWeight="SemiBold" FontSize="14" Text="Character name"/></Border></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Label Text"/><TextBox x:Name="LabelBox" TextChanged="LabelBox_TextChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Label Colour"/><local:ColourField x:Name="CharColourBox" FallbackHex="#FFFFFF" AllowEmpty="True"/></StackPanel></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Label Size"/><TextBox x:Name="CharLabelSizeBox" TextChanged="CharLabelStyle_TextChanged"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Label Opacity (%)"/><TextBox x:Name="CharLabelOpacityBox" TextChanged="CharLabelStyle_TextChanged"/></StackPanel><StackPanel Grid.Column="2" Margin="4,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Thumbnail Width"/><TextBox x:Name="CharWidthBox"/></StackPanel><StackPanel Grid.Column="3" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Thumbnail Height"/><TextBox x:Name="CharHeightBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Empty label = character name. Size: 6–72. Opacity: 10–100. Width: 80–1600. Height: 0 = auto, or 45–1200."/></StackPanel>
</Expander>

<Expander x:Name="CardInteraction" Header="INTERACTION AND HIDING" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Click to switch. Shift + right-drag to move. Shift + drag the orange corner to resize."/><CheckBox x:Name="ClickableBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Character thumbnails are clickable"/></CheckBox><CheckBox x:Name="LoginClickableBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Login screen thumbnails are clickable"/></CheckBox><CheckBox x:Name="LockBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Lock thumbnail positions and sizes (no moving or resizing)"/></CheckBox><CheckBox x:Name="SnapBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Snap thumbnails together when dragged close"/></CheckBox><CheckBox x:Name="OnTopBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Keep thumbnails always on top of other windows"/></CheckBox><CheckBox x:Name="HideActiveBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Hide the thumbnail of the client I'm currently in"/></CheckBox><CheckBox x:Name="HideUnfocusedBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Hide all thumbnails while EVE isn't the window in front"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,4,0"><TextBox Style="{StaticResource FieldLabel}" Text="Snap Distance (px)"/><TextBox x:Name="SnapDistBox"/></StackPanel><StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBox Style="{StaticResource FieldLabel}" Text="Delay Before Hiding (ms)"/><TextBox x:Name="HideDelayBox"/></StackPanel></Grid><TextBox Style="{StaticResource Desc}" Text="Snap: 1–100 px. Hide delay: 0–5000 ms."/></StackPanel>
</Expander>
</StackPanel></ScrollViewer>
<ScrollViewer x:Name="PageGroups" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><StackPanel Margin="16,12,16,4" MaxWidth="1000" HorizontalAlignment="Stretch">
<Expander x:Name="CardRoster" Header="CHARACTERS" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Characters that get a thumbnail. Tick to show, untick to hide. + adds a line."/><TextBox Style="{StaticResource FieldLabel}" Text="Group In Use" /><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ThumbGroupBox" Margin="0" SelectionChanged="ThumbGroup_SelectionChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="NewThumbGroupBtn" Content="New" Padding="10,4" Margin="0,0,5,0" Click="NewThumbGroup_Click"/><Button x:Name="RenameThumbGroupBtn" Content="Rename" Padding="10,4" Margin="0,0,5,0" Click="RenameThumbGroup_Click"/><Button x:Name="DeleteThumbGroupBtn" Content="Delete" Padding="10,4" Style="{StaticResource DangerButton}" Click="DeleteThumbGroup_Click"/></StackPanel></Grid><StackPanel x:Name="ClientChecks"/><WrapPanel Margin="0,0,0,2"><Button x:Name="AddThumbBtn" Content="+  Add character" Padding="10,4" Margin="0,0,6,6" Click="AddThumb_Click" Style="{StaticResource PrimaryButton}"/><Button x:Name="SelectAllBtn" Content="Select all" Padding="10,4" Margin="0,0,6,6" Click="SelectAll_Click" /><Button x:Name="SelectNoneBtn" Content="Select none" Padding="10,4" Margin="0,0,6,6" Click="SelectNone_Click" /></WrapPanel><CheckBox x:Name="LoginScreensBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Login screens (clients that aren't logged in yet)"/></CheckBox><CheckBox x:Name="ShowUnlistedBox"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Also show characters not in this group"/></CheckBox></StackPanel>
</Expander>
<Expander x:Name="CardScan" Header="FIND RUNNING CLIENTS" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="Lists the characters logged in now. Tick and add them to the group."/><WrapPanel Margin="0,0,0,2"><Button x:Name="ScanBtn" Content="Scan running clients" Padding="10,4" Margin="0,0,6,6" Click="Scan_Click" /><Button x:Name="ScanAllBtn" Content="Select all" Padding="10,4" Margin="0,0,6,6" Click="ScanSelectAll_Click" /><Button x:Name="AddScannedBtn" Content="Add selected" Padding="10,4" Margin="0,0,6,6" Click="AddScanned_Click" Style="{StaticResource PrimaryButton}" /></WrapPanel><TextBox x:Name="ScanNote" Style="{StaticResource Desc}" Text="Press Scan to look for clients."/><Border x:Name="ScanBox" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="3" Background="{StaticResource BrushInput}" Padding="12,10,12,2" MinHeight="46" Margin="0,0,0,12"><ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ScanHost"/></ScrollViewer></Border></StackPanel>
</Expander>
<Expander x:Name="CardClientOrder" Header="CLIENT ORDER AND POSITIONS" Style="{StaticResource Card}" IsExpanded="False">
<StackPanel><TextBox Style="{StaticResource Desc}" Text="The client order is used by cycling, client hotkeys and positions."/><TextBox Style="{StaticResource FieldLabel}" Text="1. How Clients Are Ordered"/><RadioButton x:Name="OrderAutoRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Automatic: the order they were opened"/></RadioButton><RadioButton x:Name="OrderSavedRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Saved: each account keeps its slot"/></RadioButton><RadioButton x:Name="OrderManualRadio" GroupName="ClientOrder" Checked="OrderMode_Changed"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="Manual: you pick the order below"/></RadioButton><StackPanel x:Name="OrderCapturePanel" Margin="0,6,0,4"><TextBox Style="{StaticResource Desc}" Text="Open your clients in order, log in, then press Save current order. Choose Saved to use it."/><WrapPanel Margin="0,0,0,2"><Button x:Name="SaveOrderBtn" Content="Save current order" Padding="10,4" Margin="0,0,6,6" Click="SaveCurrentOrder_Click" Style="{StaticResource PrimaryButton}"/></WrapPanel><TextBox x:Name="SaveOrderNote" Style="{StaticResource Desc}" Text=""/></StackPanel><StackPanel x:Name="OrderSavedPanel" Margin="0,12,0,0" Visibility="Collapsed"><TextBox Style="{StaticResource FieldLabel}" Text="Saved Order" /><TextBox x:Name="SavedOrderText" Style="{StaticResource Desc}" Text=""/><TextBox x:Name="OrderResetNote" Style="{StaticResource Desc}" Foreground="{StaticResource BrushAccentHover}" Visibility="Collapsed" Text=""/><WrapPanel Margin="0,0,0,2"><Button x:Name="ResetOrderBtn" Content="Reset order" Padding="10,4" Margin="0,0,6,6" Click="ResetOrder_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Reset clears the saved order now. Open clients go back to opening order."/></StackPanel><StackPanel x:Name="OrderListPanel" Margin="0,12,0,0"><TextBox Style="{StaticResource Desc}" Text="Tick a character, then use the arrows to move it. Unticked ones go last."/><WrapPanel Margin="0,0,0,2"><Button x:Name="OrderTickAllBtn" Content="Tick all" Padding="10,4" Margin="0,0,6,6" Click="OrderTickAll_Click" /><Button x:Name="OrderUntickAllBtn" Content="Untick all" Padding="10,4" Margin="0,0,6,6" Click="OrderUntickAll_Click" /></WrapPanel><TextBox x:Name="NoOrderText" Style="{StaticResource Desc}" Visibility="Collapsed" Text="No characters yet. Log in a client, then reopen this window."/><StackPanel x:Name="OrderChecks"/></StackPanel><Border BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Margin="0,4,0,8"/><TextBox Style="{StaticResource FieldLabel}" Text="2. Where Thumbnail Positions Are Remembered"/><RadioButton x:Name="ModeCharacterRadio" GroupName="PositionMode" Checked="PositionMode_Changed"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="By character: each character keeps its spot"/></RadioButton><RadioButton x:Name="ModeClientRadio" GroupName="PositionMode" Checked="PositionMode_Changed"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="By client: each slot number keeps its spot"/></RadioButton><TextBox x:Name="OrderPositionNote" Style="{StaticResource Desc}" Foreground="{StaticResource BrushAccentHover}" Margin="0,0,0,8" Visibility="Collapsed" Text="Positions follow the slot number. Use Saved or Manual order to keep them fixed."/><CheckBox x:Name="InheritBox" Margin="0,2,0,8"><TextBox Style="{StaticResource SelectableText}" HorizontalAlignment="Left" Text="A new character takes its login screen's spot"/></CheckBox><WrapPanel Margin="0,0,0,2"><Button x:Name="RecoverBtn" Content="Recover off-screen thumbnails" Padding="10,4" Margin="0,0,6,6" Click="Recover_Click" /><Button x:Name="ResetPosBtn" Content="Reset all positions" Padding="10,4" Margin="0,0,6,6" Click="ResetPositions_Click" /></WrapPanel><TextBox Style="{StaticResource Desc}" Text="Recover brings off-screen thumbnails back to your main monitor."/><Border BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Margin="0,4,0,8"/><TextBox Style="{StaticResource FieldLabel}" Text="3. Saved Layouts"/><TextBox Style="{StaticResource Desc}" Text="Save the order and positions as a layout. Load one to swap. Saved straight away."/><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="LayoutCombo" Margin="0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0"><Button Content="Load" Padding="10,4" Margin="0,0,6,0" Click="LoadLayout_Click" ToolTip="Put this layout in place"/><Button Content="Save as new" Padding="10,4" Margin="0,0,6,0" Click="SaveLayout_Click" ToolTip="Save the current order and positions as a new layout"/><Button Content="Update" Padding="10,4" Margin="0,0,6,0" Click="UpdateLayout_Click" ToolTip="Replace this layout with the current order and positions"/><Button Content="Delete" Padding="10,4" Style="{StaticResource DangerButton}" Click="DeleteLayout_Click" ToolTip="Delete this layout"/></StackPanel></Grid><TextBox Style="{StaticResource FieldLabel}" Text="New Thumbnails Stack"/><ComboBox x:Name="StackDirectionBox"/><TextBox Style="{StaticResource Desc}" Text="Where thumbnails with no saved spot go."/></StackPanel>
