<Window x:Class="AUTZ.IronWorks.Preview.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUTZ IronWorks Preview"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#10151C"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False">
    <Border BorderBrush="#334155" BorderThickness="1" Padding="7">
        <StackPanel>
            <Grid Height="30" Background="#18202A" MouseLeftButtonDown="Header_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◆" Foreground="#F59E0B" Margin="8,0,7,0"/>
                    <TextBlock Text="AUTZ IRONWORKS PREVIEW" FontWeight="Bold" FontSize="11" Foreground="#CBD5E1"/>
                </StackPanel>
                <Button Grid.Column="1" Content="⚙" Width="30" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Click="Settings_Click"/>
            </Grid>
            <StackPanel x:Name="ClientPanel" Margin="0,6,0,0"/>
            <TextBlock x:Name="EmptyMessage" Text="Waiting for EVE clients…" Foreground="#94A3B8" Padding="18"/>
        </StackPanel>
    </Border>
</Window>
