<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EVE-IW-Preview</AssemblyName>
    <RootNamespace>AUTZ.IronWorks.Preview</RootNamespace>
    <Version>0.10.2</Version>
    <Product>EVE-IronWorks-Preview</Product>
    <Company>AUTZ IronWorks</Company>
    <Authors>AUTZ IronWorks</Authors>
    <Description>EVE-IW-Preview (EVE-IronWorks-Preview): live previews and instant switching for your EVE Online clients, by AUTZ IronWorks</Description>
    <Copyright>AUTZ IronWorks</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>


  <!-- The AUTZ IronWorks emblem (lava icon): used for the exe/tray icon and shown inside the app windows. -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- WPF + WinForms in one project: stop WinForms/Drawing being global usings,
       otherwise Application, MessageBox, Color, Brushes, ColorConverter etc. become ambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>



