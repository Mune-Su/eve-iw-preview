<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AUTZ.IronWorks.Preview</AssemblyName>
    <RootNamespace>AUTZ.IronWorks.Preview</RootNamespace>
    <Version>0.1.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- WPF + WinForms in one project: stop WinForms/Drawing being global usings,
       otherwise Application, MessageBox, Color, Brushes, ColorConverter etc. become ambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
